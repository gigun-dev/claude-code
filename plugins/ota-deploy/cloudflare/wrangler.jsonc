{
  "name": "ota-distribution",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "ota-distribution",
    },
  ],
}
