#!/usr/bin/env python3
"""Local Claude Code and Codex transcript breakdown.

The transcript formats are intentionally handled here instead of being sent to
Langfuse. A local report can say how much time is represented by a recorded
tool or wait interval; the remaining time is explicitly ``unattributed``. It
is not a claim about model thinking time, subscription cost, or billing.
"""

import argparse
import datetime as dt
import glob
import json
import os
import re
import sys
from collections import Counter, defaultdict


BASH_RULES = [
    ("test", r"tools/test\.sh|(^|\s)(pytest|ctest)\b|python3? -m (unittest|pytest)|npm (run )?test\b|(go|cargo|swift) test\b|tests/run\.sh|verify\.sh"),
    ("build", r"idf-board\.sh\s+\S+\s+(build|flash)|idf\.py\b|(^|\s)(cmake|make|xcodebuild|ninja)\b|(cargo|go) build\b|npm run build\b|(^|\s)(cc|gcc|clang|clang\+\+|g\+\+)\s+-"),
    ("git", r"(^|\s|\|)git\s"),
    ("wait", r"(^|\s|;)sleep\s|while .*(sleep|-lt)"),
    ("read", r"(^|\s|\||;|\()(grep|rg|find|ls|cat|head|tail|sed|awk|wc|diff|pwd|stat|file|du|nl|jq|test\s+-)\b"),
    ("write-file", r"(^|\s|;)(mkdir|cp|mv|rm|touch|chmod|tee)\b|>\s*\S"),
]
BASH_RULES_C = [(name, re.compile(pattern)) for name, pattern in BASH_RULES]


def classify(command):
    for name, pattern in BASH_RULES_C:
        if pattern.search(command or ""):
            return name
    return "other"


def _number(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return value
    return None


def parse_ts(value):
    """Parse ISO-8601 or Unix seconds/milliseconds into an aware datetime."""
    if isinstance(value, dt.datetime):
        return value if value.tzinfo else value.replace(tzinfo=dt.timezone.utc)
    number = _number(value)
    if number is not None:
        if abs(number) > 100_000_000_000:
            number /= 1000
        return dt.datetime.fromtimestamp(number, tz=dt.timezone.utc)
    if not value:
        return None
    text = str(value).strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)


def parse_window(value, label):
    parsed = parse_ts(value)
    if parsed is None:
        raise ValueError(f"--{label} は ISO-8601 / Unix timestamp で指定する: {value}")
    return parsed.astimezone(dt.timezone.utc)


def iter_lines(path):
    try:
        with open(path, errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except json.JSONDecodeError:
                    continue
    except OSError:
        return


def _clip_interval(start, end, window_start, window_end):
    if start is None or end is None:
        return None
    if end < start:
        start, end = end, start
    clipped_start = max(start, window_start)
    clipped_end = min(end, window_end)
    if clipped_end <= clipped_start:
        return None
    return clipped_start, clipped_end


def _union(intervals):
    """Return the duration of possibly overlapping aware datetime intervals."""
    if not intervals:
        return 0.0
    ordered = sorted((start, end) for start, end in intervals if end > start)
    if not ordered:
        return 0.0
    total = 0.0
    current_start, current_end = ordered[0]
    for start, end in ordered[1:]:
        if start > current_end:
            total += (current_end - current_start).total_seconds()
            current_start, current_end = start, end
        else:
            current_end = max(current_end, end)
    return total + (current_end - current_start).total_seconds()


def _fmt_iso(value):
    return value.isoformat().replace("+00:00", "Z") if value else None


def _json_arguments(value):
    if isinstance(value, dict):
        return value
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
            return parsed if isinstance(parsed, dict) else {}
        except json.JSONDecodeError:
            return {}
    return {}


def _command_from_input(value):
    if isinstance(value, str):
        return value
    if not isinstance(value, dict):
        return ""
    for key in ("command", "cmd", "shell_command", "script"):
        candidate = value.get(key)
        if isinstance(candidate, list):
            return " ".join(str(part) for part in candidate)
        if isinstance(candidate, str):
            return candidate
    return ""


def _is_wait(name, command=""):
    text = f"{name or ''} {command or ''}".lower()
    return bool(re.search(r"(^|[/:_\s-])(wait|sleep|poll)([/\s:_-]|$)", text))


class Body:
    """One Claude main/sidechain or one Codex thread."""

    def __init__(self, source, kind, ident, path, meta=None, parent_id=None):
        self.source = source
        self.kind = kind
        self.id = ident
        self.path = path
        self.meta = meta or {}
        self.parent_id = parent_id
        self.root_id = ident
        self.activity_times = []
        self.tool_intervals = []
        self.task_intervals = []
        self.usage_records = []
        self.usage_seen = 0
        self.tools = Counter()
        self._tool_call_records = []
        self.tool_secs = Counter()
        self.bash_secs = defaultdict(float)
        self.bash_n = Counter()
        self.bash_cmds = Counter()
        self.bash_slow = []
        self.cwds = Counter()
        self.paths_touched = Counter()
        self.models = Counter()
        self.requests = 0
        self.last_write = None
        self.write_times = []
        self._tool_call_ids = set()
        self._window_start = None
        self._window_end = None
        self._raw_first = None
        self._raw_last = None
        self.first = None
        self.last = None
        self.active = False
        self.selected_tool_intervals = []
        self.selected_task_intervals = []
        self.selected_usage_records = []

    def add_activity(self, timestamp):
        if timestamp is not None:
            self.activity_times.append(timestamp)

    def feed(self, path):
        """Backward-compatible Claude feeder for callers of the old CLI."""
        _feed_claude_records(self, list(iter_lines(path)))

    def add_tool_call(self, name, call_id=None, timestamp=None):
        key = call_id or f"anonymous:{len(self._tool_call_records)}:{name}"
        if key in self._tool_call_ids:
            return
        self._tool_call_ids.add(key)
        self._tool_call_records.append({"name": name or "?", "id": call_id,
                                        "timestamp": timestamp, "key": key})

    def add_tool_interval(self, start, end, name, command="", call_id=None,
                          origin="paired", turn_id=None):
        if start is None or end is None:
            return
        if end < start:
            start, end = end, start
        self.tool_intervals.append({
            "start": start,
            "end": end,
            "name": name or "?",
            "command": command or "",
            "call_id": call_id,
            "origin": origin,
            "turn_id": turn_id,
            "wait": _is_wait(name, command),
        })

    def add_task_interval(self, start, end, turn_id=None, origin="task"):
        if start is None or end is None:
            return
        if end < start:
            start, end = end, start
        self.task_intervals.append({"start": start, "end": end,
                                    "turn_id": turn_id, "origin": origin})

    def add_usage(self, timestamp, usage, response_id=None, record_id=None):
        self.usage_seen += 1
        if not isinstance(usage, dict):
            return
        self.usage_records.append({
            "timestamp": timestamp,
            "usage": usage,
            "response_id": response_id,
            "record_id": record_id,
        })

    def add_path(self, tool, path):
        if isinstance(path, str) and path:
            self.paths_touched[(tool, path)] += 1

    def _all_interval_points(self):
        points = list(self.activity_times)
        for interval in self.tool_intervals + self.task_intervals:
            points.extend((interval["start"], interval["end"]))
        return [point for point in points if point is not None]

    def overlaps(self, window_start, window_end):
        if any(window_start <= point < window_end for point in self.activity_times):
            return True
        for interval in self.tool_intervals + self.task_intervals:
            if interval["start"] < window_end and interval["end"] > window_start:
                if interval["end"] > interval["start"]:
                    return True
        return False

    def _effective_tool_intervals(self):
        """Prefer item completion intervals over a paired response duplicate."""
        completed = [interval for interval in self.tool_intervals
                     if interval["origin"] == "item_completed"]
        effective = []
        for interval in self.tool_intervals:
            if interval["origin"] == "response_pair":
                duplicate = any(
                    interval["name"] == other["name"]
                    and abs((interval["start"] - other["start"]).total_seconds()) < 1.0
                    and abs((interval["end"] - other["end"]).total_seconds()) < 1.0
                    for other in completed
                )
                if duplicate:
                    continue
            effective.append(interval)
        return effective

    def _dedup_usage(self, records):
        # Usually duplicate records carry the same usage.  If a provider emits
        # an empty duplicate before the populated record, keep the populated
        # one so an otherwise available response is not reported as zero.
        by_key = {}
        ordered = sorted(records, key=lambda item: item["timestamp"] or dt.datetime.min.replace(tzinfo=dt.timezone.utc))
        for record in ordered:
            response_id = record.get("response_id")
            key = ("response", response_id) if response_id else ("record", record.get("record_id"))
            current = by_key.get(key)
            if current is None or _usage_score(record.get("usage")) > _usage_score(current.get("usage")):
                by_key[key] = record
        return sorted(by_key.values(), key=lambda item: item["timestamp"] or dt.datetime.min.replace(tzinfo=dt.timezone.utc))

    def finalize(self, window_start, window_end):
        self._window_start = window_start
        self._window_end = window_end
        points = self._all_interval_points()
        self._raw_first = min(points) if points else None
        self._raw_last = max(points) if points else None
        self.active = self.overlaps(window_start, window_end)
        if not self.active:
            return
        self.first = max(self._raw_first, window_start)
        self.last = min(self._raw_last, window_end)

        # A call that starts before the window is retained when its paired
        # interval overlaps the window, while an unrelated call is counted
        # only when its own event is in [from, to).
        self.tools = Counter()
        for call in self._tool_call_records:
            in_window = (call["timestamp"] is not None
                         and window_start <= call["timestamp"] < window_end)
            overlaps_call = any(
                interval.get("call_id") == call["id"]
                and interval["start"] < window_end
                and interval["end"] > window_start
                for interval in self._effective_tool_intervals()
            )
            if in_window or overlaps_call:
                self.tools[call["name"]] += 1

        self.selected_tool_intervals = []
        for interval in self._effective_tool_intervals():
            clipped = _clip_interval(interval["start"], interval["end"], window_start, window_end)
            if clipped:
                self.selected_tool_intervals.append((clipped, interval))
        self.selected_task_intervals = []
        for interval in self.task_intervals:
            clipped = _clip_interval(interval["start"], interval["end"], window_start, window_end)
            if clipped:
                self.selected_task_intervals.append((clipped, interval))

        selected = [record for record in self.usage_records
                    if record["timestamp"] is not None
                    and window_start <= record["timestamp"] < window_end]
        self.selected_usage_records = self._dedup_usage(selected)
        selected_writes = [timestamp for timestamp in self.write_times
                           if window_start <= timestamp < window_end]
        self.last_write = max(selected_writes) if selected_writes else None
        self.tool_secs = Counter()
        self.bash_secs = defaultdict(float)
        self.bash_slow = []
        for (start, end), interval in self.selected_tool_intervals:
            seconds = (end - start).total_seconds()
            name = interval["name"]
            self.tool_secs[name] += seconds
            if name == "Bash":
                command = interval["command"]
                category = classify(command)
                self.bash_secs[category] += seconds
                self.bash_slow.append((seconds, command))
        self.bash_n = Counter()
        self.bash_cmds = Counter()
        for interval in self._effective_tool_intervals():
            if interval["name"] != "Bash":
                continue
            clipped = _clip_interval(interval["start"], interval["end"], window_start, window_end)
            if not clipped:
                continue
            command = " ".join(interval["command"].split())
            category = classify(command)
            self.bash_n[category] += 1
            self.bash_cmds[command] += 1

    @property
    def wall(self):
        if not self.active or self.first is None or self.last is None:
            return 0.0
        return max(0.0, (self.last - self.first).total_seconds())

    @property
    def elapsed_s(self):
        return self.wall

    @property
    def bash_total(self):
        return sum(self.bash_secs.values())

    @property
    def tool_union(self):
        return _union([clipped for clipped, _ in self.selected_tool_intervals])

    @property
    def wait_union(self):
        return _union([clipped for clipped, interval in self.selected_tool_intervals
                       if interval["wait"]])

    @property
    def task_union(self):
        return _union([clipped for clipped, _ in self.selected_task_intervals])

    @property
    def unattributed(self):
        # wait intervals are normally a subset of tool intervals; use a union
        # so a wait is never subtracted twice.
        covered = _union([clipped for clipped, _ in self.selected_tool_intervals]
                         + [clipped for clipped, interval in self.selected_tool_intervals
                            if interval["wait"]])
        return max(0.0, self.elapsed_s - covered)

    @property
    def tail_after_write(self):
        if self.last_write is None or self.last is None:
            return None
        return max(0.0, (self.last - max(self.last_write, self._window_start)).total_seconds())

    @property
    def worktree(self):
        if self.meta.get("worktreePath"):
            return self.meta["worktreePath"]
        for cwd, _ in self.cwds.most_common():
            match = re.match(r"(.*/\.claude/worktrees/[^/]+)", cwd)
            if match:
                return match.group(1)
        return None

    def outside_worktree(self):
        worktree = self.worktree
        if not worktree:
            return {}
        outside = Counter()
        for (tool, path), count in self.paths_touched.items():
            if (path.startswith("/") and not path.startswith(worktree)
                    and not path.startswith(("/private/tmp", "/tmp"))):
                outside["write" if tool in ("Edit", "Write", "NotebookEdit", "FileChange") else "read"] += count
        for command, count in self.bash_cmds.items():
            for match in re.finditer(r"(/Users/[^\s\"';|)]+)", command):
                path = match.group(1)
                if not path.startswith(worktree) and "/.claude/worktrees/" not in path:
                    outside["bash-path"] += count
                    break
        return dict(outside)

    def _token_summary(self):
        records = self.selected_usage_records
        if not records:
            return unavailable_tokens()
        if self.source == "codex":
            return summarize_codex_usage(records)
        return summarize_claude_usage(records)

    def as_json(self):
        tokens = self._token_summary()
        model = self.models.most_common(1)[0][0] if self.models else None
        return {
            "source": self.source,
            "kind": self.kind,
            "id": self.id,
            "session_id": self.meta.get("session_id") or self.meta.get("sessionId") or self.id,
            "parent_id": self.parent_id,
            "forked_from_id": self.meta.get("forked_from_id"),
            "root_id": self.root_id,
            "agent_type": self.meta.get("agentType"),
            "description": self.meta.get("description"),
            "model": model,
            "path": self.path,
            "start": _fmt_iso(self.first),
            "end": _fmt_iso(self.last),
            "elapsed_s": round(self.elapsed_s, 3),
            "wall_s": round(self.wall, 3),
            "tool_s": round(self.tool_union, 3),
            "tool_union_s": round(self.tool_union, 3),
            "wait_s": round(self.wait_union, 3),
            "task_s": round(self.task_union, 3),
            "unattributed_s": round(self.unattributed, 3),
            "tool_calls": sum(self.tools.values()),
            "tools": dict(self.tools),
            "tool_secs": {name: round(seconds, 3) for name, seconds in self.tool_secs.items()},
            "requests": self.requests,
            "tokens": tokens,
            "bash": {
                "calls": sum(self.bash_n.values()),
                "total_s": round(sum(self.bash_secs.values()), 3),
                "by_category_s": {name: round(seconds, 3) for name, seconds in self.bash_secs.items()},
                "by_category_n": dict(self.bash_n),
            },
            "repeated_commands": {command: count for command, count in self.bash_cmds.items() if count > 1},
            "tail_after_last_write_s": (round(self.tail_after_write, 3)
                                         if self.tail_after_write is not None else None),
            "worktree": self.worktree,
            "spawned_with_worktree": self.meta.get("spawnedWithWorktree"),
            "cwds": dict(self.cwds),
            "outside_worktree": self.outside_worktree(),
        }


def unavailable_tokens(records=0):
    return {
        "status": "unavailable",
        "records": records,
        "peak_context": None,
        "input_tokens": None,
        "cached_input_tokens": None,
        "uncached_input_tokens": None,
        "output_tokens": None,
        "reasoning_output_tokens": None,
        "visible_output_tokens": None,
        "total_tokens": None,
        "cum_output": None,
        "cum_cache_creation": None,
        "cum_cache_read": None,
    }


def _usage_value(usage, *keys):
    for key in keys:
        value = _number(usage.get(key))
        if value is not None:
            return int(value)
    return None


def _usage_score(usage):
    if not isinstance(usage, dict):
        return 0
    keys = (
        "input_tokens", "cached_input_tokens", "cache_read_input_tokens",
        "cache_write_input_tokens", "cache_creation_input_tokens",
        "output_tokens", "reasoning_output_tokens", "total_tokens",
    )
    return sum(_usage_value(usage, key) is not None for key in keys)


def _summarizable_records(records):
    return [record for record in records if _usage_score(record.get("usage"))]


def summarize_claude_usage(records):
    usable = _summarizable_records(records)
    if not usable:
        return unavailable_tokens(len(records))
    totals = {
        "input_tokens": 0,
        "cached_input_tokens": 0,
        "uncached_input_tokens": 0,
        "output_tokens": 0,
        "reasoning_output_tokens": 0,
        "visible_output_tokens": 0,
        "total_tokens": 0,
        "cum_output": 0,
        "cum_cache_creation": 0,
        "cum_cache_read": 0,
    }
    peak = 0
    for record in usable:
        usage = record["usage"]
        input_tokens = _usage_value(usage, "input_tokens") or 0
        cache_creation = _usage_value(usage, "cache_creation_input_tokens") or 0
        cache_read = _usage_value(usage, "cache_read_input_tokens") or 0
        output = _usage_value(usage, "output_tokens") or 0
        peak = max(peak, input_tokens + cache_creation + cache_read + output)
        totals["input_tokens"] += input_tokens
        totals["cached_input_tokens"] += cache_read
        totals["uncached_input_tokens"] += input_tokens
        totals["output_tokens"] += output
        totals["visible_output_tokens"] += output
        totals["total_tokens"] += input_tokens + cache_creation + cache_read + output
        totals["cum_output"] += output
        totals["cum_cache_creation"] += cache_creation
        totals["cum_cache_read"] += cache_read
    result = {"status": "available", "records": len(usable), "peak_context": peak, **totals}
    if len(usable) != len(records):
        result["status"] = "partial"
        result["unavailable_records"] = len(records) - len(usable)
    return result


def summarize_codex_usage(records):
    usable = _summarizable_records(records)
    if not usable:
        return unavailable_tokens(len(records))
    totals = {
        "input_tokens": 0,
        "cached_input_tokens": 0,
        "uncached_input_tokens": 0,
        "output_tokens": 0,
        "reasoning_output_tokens": 0,
        "visible_output_tokens": 0,
        "total_tokens": 0,
        "cum_output": 0,
        "cum_cache_creation": 0,
        "cum_cache_read": 0,
    }
    peak = 0
    for record in usable:
        usage = record["usage"]
        input_tokens = _usage_value(usage, "input_tokens") or 0
        cached = _usage_value(usage, "cached_input_tokens", "cache_read_input_tokens") or 0
        output = _usage_value(usage, "output_tokens") or 0
        reasoning = _usage_value(usage, "reasoning_output_tokens") or 0
        total = _usage_value(usage, "total_tokens")
        cache_creation = _usage_value(usage, "cache_write_input_tokens", "cache_creation_input_tokens") or 0
        # cached input and reasoning output are subsets. ``total_tokens`` is
        # preferred as the provider's own total; never add those subsets again.
        if total is None:
            total = input_tokens + output
        peak = max(peak, input_tokens + output)
        totals["input_tokens"] += input_tokens
        totals["cached_input_tokens"] += cached
        totals["uncached_input_tokens"] += max(0, input_tokens - cached)
        totals["output_tokens"] += output
        totals["reasoning_output_tokens"] += reasoning
        totals["visible_output_tokens"] += max(0, output - reasoning)
        totals["total_tokens"] += total
        totals["cum_output"] += output
        totals["cum_cache_creation"] += cache_creation
        totals["cum_cache_read"] += cached
    result = {"status": "available", "records": len(usable), "peak_context": peak, **totals}
    if len(usable) != len(records):
        result["status"] = "partial"
        result["unavailable_records"] = len(records) - len(usable)
    return result


def _claude_meta(path):
    meta_path = path[:-6] + ".meta.json"
    if not os.path.exists(meta_path):
        return {}
    try:
        with open(meta_path, errors="replace") as handle:
            parsed = json.load(handle)
        return parsed if isinstance(parsed, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _feed_claude_records(body, records, side_agent=None):
    pending = {}
    for record in records:
        if record.get("type") not in ("assistant", "user"):
            continue
        if side_agent is None and record.get("isSidechain"):
            continue
        if side_agent is not None and not (record.get("isSidechain") and record.get("agentId") == side_agent):
            continue
        timestamp = parse_ts(record.get("timestamp"))
        if timestamp is None:
            continue
        body.add_activity(timestamp)
        cwd = record.get("cwd")
        if isinstance(cwd, str):
            body.cwds[cwd] += 1
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        if record.get("type") == "assistant":
            body.requests += 1
            body.add_usage(timestamp, message.get("usage"), message.get("id"), record.get("uuid"))
            if message.get("model"):
                body.models[message["model"]] += 1
        content = message.get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            block_type = block.get("type")
            if block_type == "tool_use":
                tool_id = block.get("id")
                name = block.get("name", "?")
                command = _command_from_input(block.get("input"))
                body.add_tool_call(name, tool_id, timestamp)
                pending[tool_id] = (timestamp, name, command, tool_id)
                if name in ("Edit", "Write", "NotebookEdit"):
                    body.write_times.append(timestamp)
                input_value = block.get("input") or {}
                if isinstance(input_value, dict):
                    for key in ("file_path", "path", "notebook_path"):
                        body.add_path(name, input_value.get(key))
            elif block_type == "tool_result":
                tool_id = block.get("tool_use_id")
                started = pending.pop(tool_id, None)
                if started:
                    start, name, command, call_id = started
                    body.add_tool_interval(start, timestamp, name, command, call_id, "claude_pair")


def parse_claude_file(path, kind="main", ident=None, parent_id=None, meta=None, side_agent=None):
    records = list(iter_lines(path))
    if ident is None:
        ident = os.path.basename(path)[:-6]
    body = Body("claude", kind, ident, path, meta=meta, parent_id=parent_id)
    _feed_claude_records(body, records, side_agent=side_agent)
    return body


def _codex_id_from_path(path):
    stem = os.path.basename(path)[:-6]
    matches = re.findall(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", stem, re.I)
    return matches[-1] if matches else stem.removeprefix("rollout-").split("-")[-1]


def _codex_meta(records, ident):
    candidates = [record.get("payload") or {} for record in records
                  if record.get("type") == "session_meta"
                  and isinstance(record.get("payload"), dict)]
    if not candidates:
        return {}
    for candidate in candidates:
        if candidate.get("id") == ident or candidate.get("thread_id") == ident:
            return candidate
    return candidates[0]


def _codex_record_thread(record):
    payload = record.get("payload") or {}
    return payload.get("thread_id") or record.get("thread_id")


def _codex_record_turn(record):
    payload = record.get("payload") or {}
    turn_id = payload.get("turn_id") or record.get("turn_id")
    if turn_id:
        return turn_id
    passthrough = payload.get("internal_chat_message_metadata_passthrough")
    if isinstance(passthrough, dict):
        return passthrough.get("turn_id")
    return None


def _codex_item_interval(record):
    payload = record.get("payload") or {}
    started = parse_ts(payload.get("started_at_ms") or payload.get("started_at"))
    completed = parse_ts(payload.get("completed_at_ms") or payload.get("completed_at"))
    item = payload.get("item") or {}
    if started is None or completed is None:
        end = parse_ts(record.get("timestamp"))
        duration = item.get("duration")
        if isinstance(duration, dict):
            seconds = (_number(duration.get("secs")) or 0) + ((_number(duration.get("nanos")) or 0) / 1_000_000_000)
            if end is not None:
                started, completed = end - dt.timedelta(seconds=seconds), end
        elif end is not None and _number(item.get("duration_ms")) is not None:
            seconds = _number(item.get("duration_ms")) / 1000
            started, completed = end - dt.timedelta(seconds=seconds), end
    return started, completed, item


def _codex_item_name(item):
    item_type = str(item.get("type") or "").lower().replace("_", "")
    if item_type == "commandexecution":
        return "Bash"
    if item_type == "mcptoolcall":
        return item.get("tool") or item.get("name") or "McpToolCall"
    if item_type == "collabagenttoolcall":
        return f"collaboration:{item.get('tool') or item.get('kind') or 'tool'}"
    if item_type == "filechange":
        return "FileChange"
    return None


def _codex_item_command(item):
    command = item.get("command")
    if isinstance(command, list):
        return " ".join(str(part) for part in command)
    if isinstance(command, str):
        return command
    return ""


def _codex_record_thread_matches(record, ident, turn_threads):
    thread = _codex_record_thread(record)
    if thread and thread != ident:
        return False
    turn = _codex_record_turn(record)
    if turn and turn_threads.get(turn) and turn_threads[turn] != ident:
        return False
    return True


def parse_codex_file(path, ident=None):
    records = sorted(list(iter_lines(path)), key=lambda item: (item.get("ordinal", 0), item.get("timestamp", "")))
    path_ident = _codex_id_from_path(path)
    if ident is None:
        ident = path_ident
    meta = _codex_meta(records, ident)
    actual_id = meta.get("id") or meta.get("thread_id") or ident
    if ident == path_ident:
        ident = actual_id
    source_meta = meta.get("source") if isinstance(meta.get("source"), dict) else {}
    nested_parent = (((source_meta.get("subagent") or {}).get("thread_spawn") or {})
                     .get("parent_thread_id"))
    # forked_from_id is a regular conversation fork and is deliberately kept
    # as metadata, not treated as a subagent parent.  Codex subagents in some
    # versions put the parent only under source.subagent.thread_spawn.
    parent_id = None
    declared_parent = meta.get("parent_thread_id")
    if declared_parent or nested_parent or meta.get("thread_source") == "subagent":
        parent_id = declared_parent or nested_parent
    kind = "subagent" if parent_id or meta.get("thread_source") == "subagent" else "main"
    body_meta = dict(meta)
    body_meta.setdefault("session_id", meta.get("session_id") or ident)
    body = Body("codex", kind, ident, path, meta=body_meta, parent_id=parent_id)

    turn_threads = {}
    for record in records:
        payload = record.get("payload") or {}
        if record.get("type") in ("event_msg", "token_usage_record"):
            thread = payload.get("thread_id")
            turn = payload.get("turn_id")
            if thread and turn:
                turn_threads[turn] = thread

    pending = {}
    task_starts = {}
    for record in records:
        record_type = record.get("type")
        payload = record.get("payload") or {}
        if record_type == "session_meta":
            if (payload.get("id") or payload.get("thread_id")) != ident:
                continue
            body.add_activity(parse_ts(payload.get("timestamp")))
            if isinstance(payload.get("cwd"), str):
                body.cwds[payload["cwd"]] += 1
            continue
        if not _codex_record_thread_matches(record, ident, turn_threads):
            continue
        timestamp = parse_ts(record.get("timestamp"))
        body.add_activity(timestamp)
        if record_type == "token_usage_record":
            # event_msg/token_count is intentionally ignored.  It is a stream
            # snapshot, while this record is the response-level usage source.
            body.add_usage(timestamp, payload.get("usage"), payload.get("response_id"), record.get("ordinal"))
            continue
        if record_type == "event_msg":
            event_type = payload.get("type")
            if event_type in ("task_started", "task_complete", "turn_aborted"):
                turn_id = payload.get("turn_id")
                start = parse_ts(payload.get("started_at"))
                end = parse_ts(payload.get("completed_at"))
                if event_type == "task_started":
                    if start is None:
                        start = timestamp
                    if start is not None:
                        body.add_activity(start)
                    task_starts[turn_id] = start
                else:
                    if end is None:
                        end = timestamp
                    started = task_starts.pop(turn_id, None)
                    if started is not None and end is not None:
                        body.add_task_interval(started, end, turn_id, "task")
                    elif start is not None and end is not None:
                        body.add_task_interval(start, end, turn_id, "task")
            elif event_type == "item_completed":
                start, end, item = _codex_item_interval(record)
                name = _codex_item_name(item)
                if name and start is not None and end is not None:
                    command = _codex_item_command(item)
                    call_id = item.get("id")
                    body.add_tool_call(name, call_id, start)
                    body.add_tool_interval(start, end, name, command, call_id,
                                           "item_completed", payload.get("turn_id"))
                    if name == "Bash":
                        cwd = item.get("cwd")
                        if isinstance(cwd, str):
                            body.cwds[cwd] += 1
                    if _codex_item_name(item) == "FileChange":
                        body.write_times.append(start)
                        changes = item.get("changes") or {}
                        if isinstance(changes, dict):
                            paths = changes.keys()
                        elif isinstance(changes, list):
                            paths = [change.get("path") for change in changes
                                     if isinstance(change, dict)]
                        else:
                            paths = []
                        for file_path in paths:
                            body.add_path("FileChange", file_path)
            continue
        if record_type != "response_item":
            continue
        item_type = payload.get("type")
        turn_id = _codex_record_turn(record)
        if item_type in ("function_call", "custom_tool_call"):
            call_id = payload.get("call_id") or payload.get("id")
            name = payload.get("name") or "tool"
            if payload.get("namespace"):
                name = f"{payload['namespace']}:{name}"
            arguments = _json_arguments(payload.get("arguments") or payload.get("input"))
            command = _command_from_input(arguments)
            body.add_tool_call(name, call_id, timestamp)
            pending[call_id] = (timestamp, name, command, call_id, turn_id)
            for key in ("path", "file_path", "notebook_path"):
                body.add_path(name, arguments.get(key))
        elif item_type in ("function_call_output", "custom_tool_call_output"):
            call_id = payload.get("call_id") or payload.get("id")
            started = pending.pop(call_id, None)
            if started:
                start, name, command, original_id, original_turn = started
                body.add_tool_interval(start, timestamp, name, command, original_id,
                                       "response_pair", original_turn)
    return body


def _claude_project_dir(root, project):
    if project:
        expanded = os.path.abspath(os.path.expanduser(project))
    else:
        expanded = os.getcwd()
    root_abs = os.path.abspath(root)
    if os.path.isdir(expanded):
        try:
            if os.path.commonpath([expanded, root_abs]) == root_abs:
                return expanded
        except ValueError:
            pass
    if not project or project.startswith(("/", "~", ".")):
        slug = re.sub(r"[^A-Za-z0-9]", "-", expanded)
    else:
        slug = project
    return os.path.join(root_abs, slug)


def _resolve_session_specs(specs, roots):
    resolved = []
    seen = set()
    for spec in specs:
        expanded = os.path.abspath(os.path.expanduser(spec))
        candidates = []
        if os.path.isfile(expanded):
            candidates = [expanded]
        elif os.path.isdir(expanded):
            candidates = sorted(glob.glob(os.path.join(expanded, "*.jsonl")))
        else:
            for root in roots:
                if os.path.isdir(root):
                    candidates.extend(glob.glob(os.path.join(root, "**", f"*{spec}*.jsonl"), recursive=True))
        for candidate in candidates:
            absolute = os.path.abspath(candidate)
            if absolute not in seen:
                seen.add(absolute)
                resolved.append(absolute)
    return resolved


def collect_claude(project=None, sessions=None, all_projects=False):
    root = os.path.abspath(os.path.expanduser(os.environ.get("CLAUDE_PROJECTS_DIR", "~/.claude/projects")))
    session_files = _resolve_session_specs(sessions or [], [root])
    if session_files:
        main_files = [path for path in session_files if "/subagents/" not in path]
        direct_side_files = [path for path in session_files if "/subagents/" in path]
    else:
        if all_projects:
            project_dirs = sorted(path for path in glob.glob(os.path.join(root, "*")) if os.path.isdir(path))
        else:
            project_dirs = [_claude_project_dir(root, project)]
        main_files = []
        for directory in project_dirs:
            main_files.extend(sorted(glob.glob(os.path.join(directory, "*.jsonl"))))
        direct_side_files = []
    bodies = []
    for main_path in main_files:
        session_id = os.path.basename(main_path)[:-6]
        main = parse_claude_file(main_path, "main", session_id)
        bodies.append(main)
        subdir = os.path.join(os.path.dirname(main_path), session_id, "subagents")
        for side_path in sorted(glob.glob(os.path.join(subdir, "*.jsonl"))):
            agent_id = os.path.basename(side_path)[len("agent-"):-len(".jsonl")]
            side = parse_claude_file(side_path, "subagent", agent_id,
                                     parent_id=session_id, meta=_claude_meta(side_path))
            bodies.append(side)
        records = list(iter_lines(main_path))
        agents = sorted({record.get("agentId") for record in records
                         if record.get("isSidechain") and record.get("agentId")})
        for agent_id in agents:
            bodies.append(parse_claude_file(main_path, "subagent", agent_id,
                                            parent_id=session_id, side_agent=agent_id))
    for side_path in direct_side_files:
        parent_session = os.path.basename(os.path.dirname(os.path.dirname(side_path)))
        agent_id = os.path.basename(side_path)[len("agent-"):-len(".jsonl")]
        bodies.append(parse_claude_file(side_path, "subagent", agent_id,
                                        parent_id=parent_session, meta=_claude_meta(side_path)))
    return bodies


def collect_codex(project=None, sessions=None, all_projects=False):
    sessions_root = os.path.abspath(os.path.expanduser(os.environ.get("CODEX_SESSIONS_DIR", "~/.codex/sessions")))
    archived_root = os.path.abspath(os.path.expanduser(os.environ.get("CODEX_ARCHIVED_SESSIONS_DIR", "~/.codex/archived_sessions")))
    roots = [sessions_root, archived_root]
    explicit_sessions = bool(sessions)
    files = _resolve_session_specs(sessions or [], roots)
    all_files = []
    for root in roots:
        if os.path.isdir(root):
            all_files.extend(glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True))
    all_files = sorted(set(all_files))
    if not files:
        files = all_files
    elif explicit_sessions:
        # A subagent filename contains its own thread ID, not the parent's.
        # An explicit parent selection therefore needs a small metadata pass
        # over the local Codex files to discover direct/indirect children.
        files = sorted(set(files))
        selected_ids = set(sessions or [])
        parsed = {}
        for path in files:
            parsed[path] = parse_codex_file(path)
            selected_ids.add(parsed[path].id)
        changed = True
        while changed:
            changed = False
            for path in all_files:
                if path in parsed:
                    continue
                candidate = parse_codex_file(path)
                if candidate.parent_id in selected_ids:
                    parsed[path] = candidate
                    files.append(path)
                    selected_ids.add(candidate.id)
                    changed = True
        files = sorted(set(files))
    if not files:
        files = []
        for root in roots:
            if os.path.isdir(root):
                files.extend(glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True))
        files = sorted(set(files))
    bodies = []
    # An explicit --session is authoritative; the default --project is the
    # caller's cwd and must not hide a selected file from another cwd.
    project_path = (os.path.abspath(os.path.expanduser(project))
                    if project and not sessions and not all_projects else None)
    for path in files:
        body = parse_codex_file(path)
        if project_path:
            cwd = body.meta.get("cwd")
            if cwd and os.path.abspath(cwd) != project_path and not os.path.abspath(cwd).startswith(project_path + os.sep):
                continue
        bodies.append(body)
    return bodies


def _set_roots(bodies):
    by_id = {body.id: body for body in bodies}
    for body in bodies:
        current = body
        seen = set()
        while current.parent_id and current.parent_id not in seen:
            seen.add(current.parent_id)
            parent = by_id.get(current.parent_id)
            if parent is None:
                current = None
                break
            current = parent
        body.root_id = current.id if current is not None else (body.parent_id or body.id)


def _group_usage(bodies):
    body_summaries = {body.id: body._token_summary() for body in bodies}
    seen = set()
    records = []
    for body in bodies:
        for record in body.selected_usage_records:
            response_id = record.get("response_id")
            key = (body.source, response_id) if response_id else (body.source, body.id, record.get("record_id"))
            if key in seen:
                continue
            seen.add(key)
            records.append(record)
    if not records:
        return unavailable_tokens()
    summary = (summarize_codex_usage(records) if bodies[0].source == "codex"
               else summarize_claude_usage(records))
    incomplete = [body_id for body_id, body_summary in body_summaries.items()
                  if body_summary.get("status") != "available"]
    if incomplete and summary.get("status") != "unavailable":
        summary["status"] = "partial"
        summary["incomplete_body_ids"] = sorted(incomplete)
    return summary


def build_groups(bodies):
    grouped = defaultdict(list)
    for body in bodies:
        # ``auto`` can read both providers; keep identical textual IDs from
        # different providers in separate groups.
        grouped[(body.source, body.root_id)].append(body)
    groups = []
    for (_source, root_id), members in sorted(grouped.items(), key=lambda item: item[0][1]):
        spans = [(body.first, body.last) for body in members
                 if body.active and body.first and body.last and body.last > body.first]
        tool_intervals = [clipped for body in members for clipped, _ in body.selected_tool_intervals]
        wait_intervals = [clipped for body in members for clipped, interval in body.selected_tool_intervals if interval["wait"]]
        elapsed = _union(spans)
        tool = _union(tool_intervals)
        wait = _union(wait_intervals)
        groups.append({
            "id": root_id,
            "body_ids": [body.id for body in sorted(members, key=lambda item: item.id)],
            "parent_ids": sorted({body.parent_id for body in members if body.parent_id}),
            "elapsed_s": round(elapsed, 3),
            "wall_s": round(elapsed, 3),
            "tool_s": round(tool, 3),
            "wait_s": round(wait, 3),
            "unattributed_s": round(max(0.0, elapsed - _union(tool_intervals + wait_intervals)), 3),
            "tokens": _group_usage(members),
        })
    return groups


def _body_json_for_human(body):
    item = body.as_json()
    item["_bash_slow"] = sorted(body.bash_slow, reverse=True)
    return item


def fmt_secs(seconds):
    return f"{seconds / 60:.1f}m" if seconds >= 60 else f"{seconds:.1f}s"


def print_human(result, top_commands):
    print(f"# session-breakdown source={result['source']} ({result['from']} 〜 {result['to']})")
    print(f"  対象: {', '.join(result['files']) if result['files'] else '(なし)'}")
    print("  elapsed = 記録された活動の窓内の経過時間(親子で重なる時間は group で和集合)。")
    print("  tool = 対応付けできた tool call/result の和集合、wait = 明示された待機の和集合。")
    print("  unattributed = tool/wait に分類できない時間。モデル思考時間や費用とは解釈しない。")
    print("  トークンは Codex の response_id 重複を除外し、cached input / reasoning output は各々の部分集合として表示する。")
    print("  Bash 分類規則(上から順に最初に当たったもの): " + " > ".join(name for name, _ in BASH_RULES) + " > other")
    print()
    header = f"{'start':24} {'elapsed':>9} {'tool':>9} {'wait':>8} {'unknown':>9} {'tokens':>10}  source/kind/id / parent"
    print(header)
    print("-" * len(header))
    for body in result["bodies"]:
        tokens = body["tokens"]
        token_text = (f"{tokens['total_tokens']:,}" if tokens["status"] == "available" else tokens["status"])
        parent = body["parent_id"] or "-"
        print(f"{(body['start'] or '-'):<24} {fmt_secs(body['elapsed_s']):>9} {fmt_secs(body['tool_s']):>9} "
              f"{fmt_secs(body['wait_s']):>8} {fmt_secs(body['unattributed_s']):>9} {token_text:>10}  "
              f"{body['source']}/{body['kind']}/{body['id']} / {parent}")
    print()
    for body in result["bodies"]:
        print(f"== {body['description'] or body['id']} [{body['source']}, {body['kind']}, {body['id']}]")
        print(f"   transcript: {body['path']}")
        print(f"   parent: {body['parent_id'] or '-'} / root: {body['root_id']}")
        print(f"   elapsed {fmt_secs(body['elapsed_s'])} / tool {fmt_secs(body['tool_s'])} / "
              f"wait {fmt_secs(body['wait_s'])} / unattributed {fmt_secs(body['unattributed_s'])}")
        print("   tools: " + (", ".join(f"{name}×{count}" for name, count in body["tools"].items()) or "(なし)"))
        tokens = body["tokens"]
        if tokens["status"] == "unavailable":
            print("   トークン: 利用不可(この窓に対応する usage がない、または形式未対応)")
        elif tokens["status"] == "partial":
            print(f"   トークン: 一部利用不可(利用可能レコード {tokens['records']}, "
                  f"欠損 {tokens.get('unavailable_records', 0)})")
        else:
            print(f"   トークン: total {tokens['total_tokens']:,} / input {tokens['input_tokens']:,} "
                  f"(cached {tokens['cached_input_tokens']:,}) / output {tokens['output_tokens']:,} "
                  f"(reasoning {tokens['reasoning_output_tokens']:,})")
        if body["bash"]["calls"]:
            parts = ", ".join(f"{name} {seconds:.1f}s×{body['bash']['by_category_n'].get(name, 0)}"
                              for name, seconds in body["bash"]["by_category_s"].items())
            print(f"   Bash: {body['bash']['total_s']:.1f}s × {body['bash']['calls']} / {parts}")
            for seconds, command in sorted(body.get("_bash_slow", []), reverse=True)[:top_commands]:
                print(f"     {seconds:7.1f}s  {' '.join(command.split())[:96]}")
        if body["repeated_commands"]:
            print("   同一コマンドの再実行:")
            for command, count in sorted(body["repeated_commands"].items(), key=lambda item: -item[1]):
                print(f"     ×{count}  {command[:92]}")
        if body["worktree"]:
            print(f"   worktree: {body['worktree']} / 外部参照: {body['outside_worktree'] or 'なし'}")
        else:
            print("   worktree: 割り当て無し")
        print()
    if result["groups"]:
        print("# 親子グループ(経過時間は重複を和集合で集計)")
        for group in result["groups"]:
            tokens = group["tokens"]
            total = tokens["total_tokens"] if tokens["status"] == "available" else tokens["status"]
            print(f"  {group['id']}: bodies={','.join(group['body_ids'])} "
                  f"elapsed={fmt_secs(group['elapsed_s'])} tool={fmt_secs(group['tool_s'])} tokens={total}")


def main(argv=None):
    parser = argparse.ArgumentParser(description="Claude Code / Codex のローカル JSONL から時間・ツール・トークンの内訳を出す")
    parser.add_argument("--source", choices=("claude", "codex", "auto"), default="claude",
                        help="読む形式(既定: claude。auto は両方)")
    parser.add_argument("--session", action="append", default=[],
                        help="セッション ID または JSONL パス。複数指定可")
    parser.add_argument("--project", default=os.getcwd(),
                        help="Claude のリポジトリパス/slug、または Codex の cwd 絞り込み")
    parser.add_argument("--all-projects", action="store_true", help="Claude/Codex の全ローカルログを対象にする")
    parser.add_argument("--since", help="Nd / Nh で遡る期間(既定: 1d)。--from と排他的")
    parser.add_argument("--from", dest="from_", help="窓の開始(ISO-8601 または Unix timestamp)")
    parser.add_argument("--to", dest="to", help="窓の終了(既定: 現在)")
    parser.add_argument("--main", action="store_true", help="Claude の本線も表示(Codex/auto は常に全体を表示)")
    parser.add_argument("--json", action="store_true", help="機械可読な JSON")
    parser.add_argument("--top-commands", type=int, default=5, help="遅い Bash の表示件数")
    args = parser.parse_args(argv)

    now = dt.datetime.now(dt.timezone.utc)
    since_value = args.since or "1d"
    if args.from_ and args.since:
        parser.error("--from と --since は同時に指定できない")
    try:
        if args.from_:
            window_start = parse_window(args.from_, "from")
        else:
            match = re.fullmatch(r"(\d+)([dh])", since_value)
            if not match:
                raise ValueError("--since は 3d / 12h の形で指定する")
            delta = dt.timedelta(days=int(match.group(1))) if match.group(2) == "d" else dt.timedelta(hours=int(match.group(1)))
            window_start = now - delta
        window_end = parse_window(args.to, "to") if args.to else now
    except ValueError as error:
        parser.error(str(error))
    if window_end < window_start:
        parser.error("--to は --from/--since より後にする")

    sources = ("claude", "codex") if args.source == "auto" else (args.source,)
    bodies = []
    for source in sources:
        if source == "claude":
            bodies.extend(collect_claude(args.project, args.session, args.all_projects))
        else:
            bodies.extend(collect_codex(args.project, args.session, args.all_projects))
    unique = []
    seen = set()
    for body in bodies:
        key = (body.source, body.kind, body.id, body.path)
        if key not in seen:
            seen.add(key)
            unique.append(body)
    bodies = unique
    for body in bodies:
        body.finalize(window_start, window_end)
    bodies = [body for body in bodies if body.active]
    _set_roots(bodies)
    if not args.main and args.source == "claude":
        shown = [body for body in bodies if body.kind == "subagent"]
    else:
        shown = bodies
    shown.sort(key=lambda body: (body.first or window_end, body.id))
    body_json = [body.as_json() for body in shown]
    group_bodies = shown if args.source == "claude" and not args.main else bodies
    result = {
        "source": args.source,
        "since": since_value if not args.from_ else None,
        "from": _fmt_iso(window_start),
        "to": _fmt_iso(window_end),
        "cutoff": _fmt_iso(window_start),
        "files": [body.path for body in shown],
        "bash_rules": [name for name, _ in BASH_RULES],
        "bodies": body_json,
        "groups": build_groups(group_bodies),
    }
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        result["bodies"] = [_body_json_for_human(body) for body in shown]
        print_human(result, max(0, args.top_commands))
    return 0


if __name__ == "__main__":
    main()
