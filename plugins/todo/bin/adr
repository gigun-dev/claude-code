#!/bin/sh
# =============================================================================
# adr — リポジトリの Architecture Decision Record を一覧し、検査し、採番する
# =============================================================================
# 書式の正は skills/adr/references/ADR-FORMAT.md(このプラグイン自身が定義する。
# 2026-09-25 に軽量 ADR として再定義した —— 上流 mattpocock/skills の vendor は
# やめた。理由は同ファイルの冒頭に書いてある)。このスクリプトはその書式を
# 検査するだけで、書式そのものの正は references/ADR-FORMAT.md 側に置く。
#
# 本文を**書く**のはエージェントの仕事で、CLI は書かない(埋める欄があると、
# 埋めるために創作が始まる)。CLI が持つのは、間違えると記録そのものが壊れる
# 2 つの操作だけ: 採番(new)と、差し替え(replace。旧 supersede)。
#
# POSIX sh + awk のみ。bash 固有機能・python・jq に依存しない。
# =============================================================================

set -u

PROG=adr

# ADR_TODAY はテスト用の注入点。日付を跨いだ実行で結果が変わるテストを書けない。
TODAY=${ADR_TODAY:-$(date +%Y-%m-%d)}

EX_USAGE=1  # 引数・状態の誤り
EX_FORMAT=2 # 検査で指摘があった

# ADR ディレクトリの解決は bin/todo と共有する(`todo ready` が決定の索引を出す
# ため)。2 箇所に持つと片方だけ直されてずれるので、lib/ の 1 本だけを読む。
ADRLIB=$(dirname "$0")/../lib/adr-dir.sh
[ -r "$ADRLIB" ] || {
	printf '%s: %s が読めない。プラグインの配置が壊れている\n' "$PROG" "$ADRLIB" >&2
	exit 1
}
. "$ADRLIB"
EX_NODIR=$ADR_EX_NODIR # ADR ディレクトリがまだ無い(内部用。外へは出さない)

# 抽出結果の区切りは US (0x1f)。タブにすると `read` が空フィールドを潰す
# —— IFS に入れたタブは POSIX 上「IFS 空白類」で、連続すると 1 個の区切りに
# 畳まれる(題だけがある = 日付も status も空、が読めなくなる)。
US=$(printf '\037')

NL='
'

die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit "${2:-$EX_USAGE}"
}

usage() {
	cat <<'EOF'
usage: adr <command>      — Architecture Decision Record を一覧・検査・採番する

  ls                       1 行 1 件で `<date> <slug> <status> <title>` を番号順に出す
  check                    書式を検査する。指摘があれば stdout に出して 2 で終わる
  new "<題>" [<slug>]      次の番号でファイルを作り、パスを出す。本文は書かない
  replace <古い> <新しい>  新しい方に `Replaces: <古い番号>` を足し、古い方を削除する

new が作るのは題・日付・`Implementation: pending` の 3 行だけ(決定の本文は
書き手が書く。埋める欄を作らない)。番号は既存の最大値 + 1 で、欠番は埋めない
(`Replaces:` が名指しした番号も max に数える。削除後も再利用しない)。
置き場が無ければ docs/adr を作る。slug は題から作る —— 小文字にして a-z0-9
以外を - に畳む。題が非 ASCII を 1 文字でも含むなら作らずに拒み、第 2 引数を
求める(ASCII の断片だけを拾うと、改名できない slug が残るため)。**同じ番号の
ファイルや NNNN-<slug>.md でない名前が 1 つでもあれば new は書かない**
(採番の当てにできないので)。

replace は新しい方が既に実在し題を持つことを確かめてから、新しい方に
`Replaces: <古い番号>` を 1 行足し(既にあれば番号を追記)、古い方のファイルを
消す(git 管理下なら `git rm`、そうでなければ `rm`)。**古いファイルは残さない**
—— 置いたままだと、次にこのリポジトリを読むエージェントが「現在なお有効な
決定」として本文を読み込む(記録は git の履歴に残るので消しても失われない)。
古い方・新しい方は番号(0004 / 4)でも slug でも指せる。

ファイルの形 (正は skills/adr/references/ADR-FORMAT.md):

  docs/adr/0003-use-manual-sql-instead-of-an-orm.md
  ┌─────────────────────────────────────────────
  │ # Use manual SQL instead of an ORM
  │
  │ Date: 2026-09-10
  │ Implementation: done
  │
  │ <何が文脈で、何を決めて、なぜか。1 段落>
  │
  │ Rejected: ORM — N+1 を隠すため
  └─────────────────────────────────────────────

  ファイル名  NNNN-<小文字ケバブの slug>.md。番号は 4 桁で、既存の最大値 + 1
              (`adr ls` の一番下 と、既存ファイルが名指しする `Replaces:` の
              最大値)。**採番後に改名しない**
  題          1 行目の `# ...`
  日付        `Date: YYYY-MM-DD` の 1 行のみ(本文中の日付は指摘される)
  Implementation:  done | pending
  Status:     任意。proposed のみ(既定は accepted。deprecated / superseded は語彙に無い)
  Rejected:   任意。複数可。`Rejected: <捨てた案> — <理由>`
  Replaces:   任意。複数可。`Replaces: <古い番号>`。`adr replace` が書く

check が見るもの:
  - ファイル名が NNNN-<小文字ケバブの slug>.md か
  - 同じ番号を 2 つ以上のファイルが持っていないか(**改名はしない。指摘だけ**)
  - 題(`# ...`)があるか
  - `Date:` があり YYYY-MM-DD か
  - `Implementation:` があり done|pending か
  - Status: の語彙が proposed|accepted のどれかか(deprecated / superseded / それ以外は指摘)
  - `Superseded by` の残骸があれば指摘(この語彙はもう無い。`adr replace` で消すこと)
  - 構造: `##` 以上の見出し・箇条書き・番号付きリスト・表・コードフェンス・
    引用・本文段落が複数、のいずれかがあれば指摘(1 決定 = 題 + 数行のフィールド +
    1 段落 + 任意のトレーラ、という形を外れているということ)
  - 内容: `[実測`・`[検査:`・`id:0123` のような todo id・`Date:` 行以外の日付、
    が本文にあれば指摘(それらは measurements / テスト名 / todo.txt /
    コミットメッセージに置く)

対象ディレクトリは $ADR_DIR。未指定なら docs/adr → docs/decisions → adr →
decisions の順に最初に見つかったもの。どれも無ければ何もせず 0 で終わる。

対話しない。データは stdout、診断は stderr。
テスト用の注入点: ADR_TODAY(new が書く日付を固定)

終了コード:
  0  成功(check は指摘なし)
  1  引数・状態の誤り(usage、new / replace の拒否)
  2  check が指摘を出した
EOF
}

# ADR ディレクトリを決める。探索そのものは lib/adr-dir.sh(bin/todo と共有)。
# ここが足しているのは、カレントディレクトリを基点にすることと、
# 「ADR_DIR が実在しない」を die に振り分けることだけ。
#
# 「1 件も無い」は誤りではないので EX_USAGE と別の値で返す —— adr_dir は
# コマンド置換の中で呼ばれ、die の exit 1 はそこで捕まってしまう。同じ 1 だと
# 「ADR_DIR の指定が誤り」が「まだ 1 件も無い」に化けて 0 で成功してしまう。
adr_dir() {
	out=$(adr_resolve_dir .)
	rc=$?
	[ "$rc" -eq 0 ] && {
		printf '%s' "$out"
		return 0
	}
	[ "$rc" -eq "$ADR_EX_BADDIR" ] &&
		die "ADR_DIR='$ADR_DIR' が無い。ディレクトリを作るか ADR_DIR を直すこと"
	return "$EX_NODIR"
}

# ディレクトリ直下の *.md を名前順に列挙する(サブディレクトリは見ない)。
adr_files() {
	find "$1" -maxdepth 1 -type f -name '*.md' 2>/dev/null | LC_ALL=C sort
}

slug_of() {
	b=${1##*/}
	printf '%s' "${b%.md}"
}

# ファイル名が NNNN-<小文字ケバブの slug>.md か。真(0)で「違反している」。
# check の指摘と new の採番はこの 1 つの判定を共有する —— 2 つ持つと、check が
# 通す名前で new が落ちる(あるいはその逆)。
name_is_bad() { # name_is_bad <slug>
	_num=${1%%-*}
	_rest=${1#*-}
	case $1 in
	*-*) ;;
	*) return 0 ;;
	esac
	case $_num in
	[0-9][0-9][0-9][0-9]) ;;
	*) return 0 ;;
	esac
	case $_rest in
	'' | *[!a-z0-9-]* | -* | *- | *--*) return 0 ;;
	esac
	return 1
}

# 2 つ以上のファイルが持っている番号を 1 行 1 つ。無ければ何も出さない。
dup_numbers() { # dup_numbers <ディレクトリ>
	adr_files "$1" |
		awk '{ sub(/.*\//, ""); if (match($0, /^[0-9]+-/)) print substr($0, 1, RLENGTH - 1) }' |
		LC_ALL=C sort | uniq -d
}

# 先頭の数字列(= 番号)。無ければ空。
num_of() {
	n=${1%%-*}
	case $n in
	'' | *[!0-9]*) printf '' ;;
	*) printf '%s' "$n" ;;
	esac
}

# 1 ファイルから title / date / status / superseded / implementation を取り出し、
# US 区切りの 1 行で返す:  date US status US superseded US title US implementation
# 見つからない項目は空。日付が YYYY-MM-DD でないときは頭に "!" を付けて返す。
# 抽出は ls と check で共有する —— 二重化すると、check が通る書き方と ls が
# 読める書き方がずれる。
#
# 日付は `Date:` の 1 行だけを読む(本文中の書き出しに置く旧い書き方はもう
# 読まない —— それを読んでしまうと「`Date:` 行以外の日付を指摘する」内容検査と
# 矛盾する)。frontmatter(`---` で挟む書き方)も読まない —— 新しい書式は
# フィールドを本文にそのまま書く。
PARSE='
function isdate(s,   m, d) {
	if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
	m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
	return (m >= 1 && m <= 12 && d >= 1 && d <= 31)
}
{
	line = $0
	sub(/\r$/, "", line)

	# --- 題 ---------------------------------------------------------------
	if (title == "" && line ~ /^#[ \t]+/) {
		sub(/^#[ \t]+/, "", line); sub(/[ \t]+$/, "", line); title = line
		next
	}

	# --- Superseded by <slug>(もう使わない語彙。check が残骸として指摘する)
	if (super == "" && line ~ /^[ \t]*(\*\*)?[Ss]uperseded by[ \t]+/) {
		sub(/^[ \t]*(\*\*)?[Ss]uperseded by[ \t]+/, "", line)
		gsub(/[*`<>]/, "", line); sub(/[ \t.]+$/, "", line); sub(/\.md$/, "", line)
		super = line
		next
	}

	# --- Status: ----------------------------------------------------------
	if (status == "" && line ~ /^[ \t]*(\*\*)?[Ss]tatus(\*\*)?:[ \t]*/) {
		sub(/^[^:]*:[ \t]*/, "", line); gsub(/[*`]/, "", line); sub(/[ \t]+$/, "", line)
		status = line
		next
	}

	# --- Implementation: ---------------------------------------------------
	if (impl == "" && line ~ /^[ \t]*(\*\*)?[Ii]mplementation(\*\*)?:[ \t]*/) {
		sub(/^[^:]*:[ \t]*/, "", line); gsub(/[*`]/, "", line); sub(/[ \t]+$/, "", line)
		impl = line
		next
	}

	# --- 日付 (Date: の 1 行だけ) -------------------------------------------
	if (datefield == "" && line ~ /^[ \t]*(\*\*)?[Dd]ate(\*\*)?:[ \t]*/) {
		sub(/^[^:]*:[ \t]*/, "", line); gsub(/[*`]/, "", line)
		sub(/^[ \t]+/, "", line); sub(/[ \t.]+$/, "", line)
		datefield = line
		next
	}
}
END {
	date = (datefield == "") ? "" : (isdate(datefield) ? datefield : ("!" datefield))
	printf "%s%s%s%s%s%s%s%s%s\n", date, us, status, us, super, us, title, us, impl
}
'

parse_file() { awk -v us="$US" "$PARSE" "$1"; }

# parse_file の結果を date / status / super / title / impl へ展開する(呼び出し
# 側の変数に置く。sh に局所変数は無いので、そのまま呼び出し側から見える)。
#
# ⚠️ ここで `read ... <<EOF` を使わないこと。macOS の /bin/sh は bash 3.2 で、
# `$( … )` の中に heredoc があると構文解析を誤る —— 2026-09-10 に実測した:
# `/bin/sh plugins/adr/bin/adr check` が「line 265: syntax error near
# unexpected token ';;'」で落ちた(テストが `sh` = Nix の新しい shell で
# 呼んでいたため気づけなかった)。読むのは 5 フィールドだけなので、
# `set --` による POSIX の分割で足りる。
set_fields() { # set_fields <ファイル>
	_parsed=$(parse_file "$1")
	_oldifs=$IFS
	set -f # 題に * が入っていてもパス名展開させない
	IFS=$US
	# shellcheck disable=SC2086
	set -- $_parsed
	IFS=$_oldifs
	set +f
	date=${1:-}
	status=${2:-}
	super=${3:-}
	title=${4:-}
	impl=${5:-}
}

# ---------------------------------------------------------------------------
cmd_ls() {
	[ $# -eq 0 ] || die "usage: adr ls   (引数は取らない)"
	dir=$(adr_dir)
	rc=$?
	[ "$rc" -eq "$EX_NODIR" ] && {
		printf '%s: ADR ディレクトリが無い(docs/adr などを探した)。まだ 1 件も無い\n' "$PROG" >&2
		return 0
	}
	[ "$rc" -eq 0 ] || exit "$rc" # die は既にメッセージを出している
	adr_files "$dir" | while IFS= read -r f; do
		slug=$(slug_of "$f")
		set_fields "$f"
		# 番号が読めないファイルも落とさずに出す —— 一覧から消えると、直す
		# きっかけが check を走らせたときにしか無くなる。並びは末尾へ回る。
		num=$(num_of "$slug")
		[ -n "$num" ] || num=99999999
		# printf の組み込み %d は先頭 0 の文字列を 8 進として読もうとし、8/9 を
		# 含む番号(例: 0528)で "invalid number" を出す(2026-09-25 実測)。
		# awk の数値変換(+0)は常に 10 進なので、そこを経由してから渡す。
		num=$(printf '%s' "$num" | awk '{ print $0 + 0 }')
		case $date in
		'' | '!'*) date='????-??-??' ;;
		esac
		# status の既定は accepted(超過分の語彙 = deprecated/superseded は無い)。
		[ -n "$status" ] || status=accepted
		[ -n "$title" ] || title='(題が無い)'
		printf '%08d\t%s %s %s %s\n' "$num" "$date" "$slug" "$status" "$title"
	done | LC_ALL=C sort | cut -f2-
}

# 構造の検査 —— 1 決定 = 題 + フィールド数行 + 本文 1 段落 + 任意のトレーラ、
# という形から外れていないか。軽さは文字数の上限ではなく形で強制する
# (2026-09-25 の裁定: 文字数に原理的な根拠が無い。形はどんな言語でも同じ)。
# 1 行 1 指摘を stdout に出す(ファイル名は付けない。呼び出し側が付ける)。
check_structure() { # check_structure <ファイル>
	awk '
	{
		line = $0
		sub(/\r$/, "", line)
	}
	NR == 1 { next } # 題の行(形式は別の場所で検査する)
	{
		t = line
		sub(/^[ \t]+/, "", t)
		if (t == "") { inpar = 0; next }

		# フィールド行(Date: / Implementation: / Status: / Rejected: / Replaces:)
		# は本文にもリスト等の見た目チェックにも数えない。
		if (t ~ /^(Date|Implementation|Status|Rejected|Replaces):/) { inpar = 0; next }

		if (t ~ /^#{2,}[ \t]/) { print "見出し(## 以上)は使えない: " t; inpar = 0; next }
		if (t ~ /^(-|\*|\+)[ \t]/) { print "箇条書きは使えない: " t; inpar = 0; next }
		if (t ~ /^[0-9]+[.)][ \t]/) { print "番号付きリストは使えない: " t; inpar = 0; next }
		if (t ~ /^```/) { print "コードフェンスは使えない: " t; inpar = 0; next }
		if (t ~ /^>/) { print "引用(>)は使えない: " t; inpar = 0; next }
		if (t ~ /\|/) { print "表(|)は使えない: " t; inpar = 0; next }

		if (!inpar) { parcount++; inpar = 1 }
	}
	END {
		if (parcount > 1) print "本文の段落が複数ある(1 段落にまとめること。数えたのは " parcount " 段落)"
	}
	' "$1"
}

# 内容の検査 —— measurements / テスト名 / todo id / 日付は本文の外に置く語彙。
# `Date:` の行そのものは対象外(日付を書く唯一の場所なので)。
#
# 日付だけは、バッククォートで囲んだコードスパン(` `...` `)の中は見ない
# —— 2026-09-25 実測: MCP の仕様バージョンは日付そのもの(例: `2026-07-28`)を
# 識別子として使う。それは経緯の記述ではなく仕様が固定した値なので、
# コードスパンに入れて書けば指摘しない(このコードスパンの扱いは skill にも
# 書いてある)。
check_content() { # check_content <ファイル>
	awk '
	{
		line = $0
		sub(/\r$/, "", line)
		if (line ~ /^[ \t]*(\*\*)?[Dd]ate(\*\*)?:[ \t]*/) next
		if (line ~ /\[実測/) print "'"'"'[実測'"'"' は本文に置かない(measurements/*.jsonl へ): " line
		if (line ~ /\[検査:/) print "'"'"'[検査:'"'"' はテスト名の参照。本文に置かない(コミットメッセージ/テストへ): " line
		if (line ~ /id:[0-9]/) print "todo の id: 参照は本文に置かない(todo.txt の see: を使う): " line

		nocode = line
		gsub(/`[^`]*`/, "", nocode)
		if (nocode ~ /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) print "'"'"'Date:'"'"' 行以外に日付がある(measurements かコミットメッセージへ。コードスパン `...` の中の日付は識別子として除外する): " line
	}
	' "$1"
}

# 検査。指摘は stdout(データではなく結果そのものなので)、1 件 2 行で出す。
cmd_check() {
	[ $# -eq 0 ] || die "usage: adr check   (引数は取らない)"
	dir=$(adr_dir)
	rc=$?
	[ "$rc" -eq "$EX_NODIR" ] && {
		printf '%s: ADR ディレクトリが無い(docs/adr などを探した)。検査するものが無い\n' "$PROG" >&2
		return 0
	}
	[ "$rc" -eq 0 ] || exit "$rc" # die は既にメッセージを出している

	n=$(adr_files "$dir" | awk 'END { print NR + 0 }')

	# 同じ番号を持つファイルの一覧(番号だけを見る。改名はしない)。
	dupnums=$(dup_numbers "$dir")

	# 指摘は一時ファイルへ書いてから読む。**`$( … )` の中に `case` を書かないこと**
	# —— macOS の /bin/sh は bash 3.2 で、コマンド置換の中の `case` を
	# `(パターン)` と括弧で始めない限り構文解析に失敗する(2026-09-10 実測。
	# `case ab in a) echo one ;; esac` を `$( )` に入れるだけで
	# 「syntax error near unexpected token ';;'」。bash 4 で直った既知の欠陥)。
	# 括弧付きパターンで逃げると、次に触る人が普通の書き方へ戻した瞬間に再発する。
	# 呼ぶ側を `$( )` から出しておけば、中は普通の sh のままでよい。
	tmpf=${TMPDIR:-/tmp}/adr-check.$$
	trap 'rm -f "$tmpf"' EXIT INT TERM
	: >"$tmpf" || die "一時ファイル $tmpf を作れない"
	{
		adr_files "$dir" | while IFS= read -r f; do
			slug=$(slug_of "$f")
			set_fields "$f"
			num=${slug%%-*}
			badname=0
			name_is_bad "$slug" && badname=1
			[ "$badname" -eq 0 ] || printf '✗ %s\n    %s\n' \
				"ファイル名が NNNN-<小文字ケバブの slug>.md でない(例: 0003-use-manual-sql-instead-of-an-orm.md)" "$f"

			if [ "$badname" -eq 0 ]; then
				case $NL$dupnums$NL in
				*"$NL$num$NL"*) printf '✗ 番号 %s を 2 つ以上のファイルが持っている(改名はしない。次の空き番号で書き直すこと)\n    %s\n' "$num" "$f" ;;
				esac
			fi

			[ -n "$title" ] || printf '✗ %s\n    %s\n' "題(1 行目の '# ...')が無い" "$f"
			case $date in
			'') printf '✗ %s\n    %s\n' \
				"日付が無い。'Date: YYYY-MM-DD' の 1 行を置くこと" "$f" ;;
			'!'*) printf '✗ 日付 '\''%s'\'' が YYYY-MM-DD でない\n    %s\n' "${date#!}" "$f" ;;
			esac
			case $impl in
			done | pending) ;;
			'') printf '✗ %s\n    %s\n' "Implementation: が無い(done か pending のどちらか)" "$f" ;;
			*) printf '✗ Implementation: '\''%s'\'' は語彙外(done|pending)\n    %s\n' "$impl" "$f" ;;
			esac
			case $status in
			'' | proposed | accepted) ;;
			*) printf '✗ Status: '\''%s'\'' は語彙外(proposed|accepted。無指定なら accepted 扱い)\n    %s\n' \
				"$status" "$f" ;;
			esac
			if [ -n "$super" ]; then
				printf '✗ %s\n    %s\n' \
					"'Superseded by' はもう使わない語彙。'adr replace <古い> <新しい>' が古い方を削除するので、残っているなら手で消すか replace をやり直すこと" "$f"
			fi

			check_structure "$f" | while IFS= read -r msg; do
				[ -n "$msg" ] || continue
				printf '✗ %s\n    %s\n' "$msg" "$f"
			done
			check_content "$f" | while IFS= read -r msg; do
				[ -n "$msg" ] || continue
				printf '✗ %s\n    %s\n' "$msg" "$f"
			done
		done
	} >"$tmpf"
	if [ -s "$tmpf" ]; then
		cat "$tmpf"
		return "$EX_FORMAT"
	fi
	printf 'check: 問題なし (%d 件)\n' "$n"
}

# ---------------------------------------------------------------------------
# new — 番号を採り、題・日付・Implementation: pending だけのファイルを作る
# ---------------------------------------------------------------------------
# 決定の本文(1 段落)は書かない。書くと、埋めるために創作が始まる(README の
# 方針)。CLI が持つのは、手でやると間違える部分 —— 採番とファイル名の形 ——
# だけ。Implementation: pending は既定として書く(新しい ADR は大抵まだ実装前
# で、これは日付と同じく判断を要らない値。実装済みの決定を後から記録するなら
# 書き手が done に書き換える)。

# 題から slug を作る。作れなければ 1 で返す(呼び出し側が slug を要求する)。
# 非 ASCII を 1 文字でも含む題からは作らない —— 実際の題は日本語で、ASCII の
# 断片だけを拾うと "tls-1-3-1-2" のような slug が**改名できない**まま残る。
slugify() { # slugify <題>
	printf '%s' "$1" | LC_ALL=C awk '
	{
		s = $0
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (c < " " || c > "~") exit 1
		}
		s = tolower(s)
		gsub(/[^a-z0-9]+/, "-", s)
		sub(/^-+/, "", s); sub(/-+$/, "", s)
		print s
		exit (s == "" ? 1 : 0)
	}'
}

# 既存ファイルすべての `Replaces: N[,N...]` が名指しする番号(削除済みの古い
# 番号を含む)。1 行 1 番号で出す。
replaced_nums() { # replaced_nums <ディレクトリ>
	adr_files "$1" | while IFS= read -r f; do
		awk '/^Replaces:[ \t]*/ { sub(/^Replaces:[ \t]*/, ""); print }' "$f"
	done | tr ',' '\n'
}

# 既存の最大値 + 1 を 4 桁で。欠番は埋めない —— 番号は採ったら永久で、欠番を
# 埋めると、退避されたファイル名や git の履歴が指す番号と食い違う。max は
# ファイル名だけでなく、現存ファイルが `Replaces:` で名指しする(= 既に
# `adr replace` で消された)番号も見る —— 消した番号を再利用しないため。
next_num() { # next_num <ディレクトリ>
	{
		adr_files "$1" | awk '{ b = $0; sub(/.*\//, "", b)
			if (match(b, /^[0-9]+-/)) print substr(b, 1, RLENGTH - 1) }'
		replaced_nums "$1"
	} | awk '{ n = $0 + 0; if (n > max) max = n } END { printf "%04d\n", max + 1 }'
}

cmd_new() {
	[ $# -ge 1 ] && [ $# -le 2 ] || die 'usage: adr new "<題>" [<slug>]'
	title=$1
	slug=${2:-}
	[ -n "$title" ] || die '題が空。usage: adr new "<題>" [<slug>]'
	case $title in
	'#'*) die "題に '#' は付けない(見出しはこのコマンドが書く)" ;;
	esac

	# slug は置き場より先に決める —— 拒むときにディレクトリだけ作って帰らない。
	if [ -z "$slug" ]; then
		slug=$(slugify "$title") ||
			die "題から slug を作れない(非 ASCII を含む)。slug を渡すこと: adr new \"$title\" <slug>"
	fi
	name_is_bad "0000-$slug" &&
		die "slug '$slug' が小文字ケバブでない(a-z 0-9 と - のみ、- で始まらず終わらず重ねない)"

	dir=$(adr_dir)
	rc=$?
	if [ "$rc" -eq "$EX_NODIR" ]; then
		# 置き場は最初の 1 件を書くときに作る(ADR-FORMAT の "lazily")。
		for c in $ADR_DIR_CANDIDATES; do
			dir=$(adr_join_dir . "$c")
			break
		done
		mkdir -p "$dir" || die "$dir を作れない"
		printf '%s: %s を作った(最初の 1 件)\n' "$PROG" "$dir" >&2
	else
		[ "$rc" -eq 0 ] || exit "$rc" # die は既にメッセージを出している
	fi

	# 採番できる状態かを先に見る。判定は check と同じもの(name_is_bad /
	# dup_numbers)を使い、指摘が 1 件でもあれば書かない —— 番号は採ったら
	# 改名できないので、読めないファイル名の隣で max+1 を当てにしない。
	dups=$(dup_numbers "$dir")
	[ -z "$dups" ] ||
		die "$dir に同じ番号のファイルがある($(printf '%s' "$dups" | tr '\n' ' '))。採番できないので書かない。adr check で見ること"
	badnames=$(adr_files "$dir" | while IFS= read -r f; do
		s=$(slug_of "$f")
		if name_is_bad "$s"; then printf '%s ' "$f"; fi
	done)
	badnames=${badnames% }
	[ -z "$badnames" ] ||
		die "$dir にファイル名が NNNN-<slug>.md でないものがある($badnames)。採番できないので書かない。adr check で見ること"

	num=$(next_num "$dir")
	file=$dir/$num-$slug.md
	[ -e "$file" ] && die "$file は既にある(上書きしない)"

	tmp=$file.$$
	printf '# %s\n\nDate: %s\nImplementation: pending\n' "$title" "$TODAY" >"$tmp" || {
		rm -f "$tmp"
		die "$tmp を書けない"
	}
	mv "$tmp" "$file" || {
		rm -f "$tmp"
		die "$file を置けない"
	}
	printf '%s\n' "$file"
}

# ---------------------------------------------------------------------------
# replace — 新しい方に Replaces: を足し、古い方のファイルを消す(旧 supersede)
# ---------------------------------------------------------------------------
# 2026-09-25 の裁定: 差し替えられた決定はファイルとして残さない。エージェントは
# コンテキストに載っているものを「今も有効」として扱う(ClashEval 2024 が
# 示した、新旧の矛盾する情報を渡されたときにモデルが古い方を選ぶ挙動。
# Claude Code の memory ドキュメントが「相反する指示を残さない」と言うのも
# 同じ理由)。だから deprecated / superseded という「まだそこにあるが無効」の
# 状態は作らない —— 置き場から消し、記録は git の履歴に譲る。

# 番号(0004 / 4)でも slug でもファイル名でも引ける。
# 0=1 件 / 1=見つからない / 2=複数に当たる(番号が重複している)。
resolve_ref() { # resolve_ref <ディレクトリ> <参照>
	adr_files "$1" | awk -v ref="$2" '
	function numof(s) { if (match(s, /^[0-9]+-/)) return substr(s, 1, RLENGTH - 1) + 0; return -1 }
	{
		f = $0; b = f; sub(/.*\//, "", b); sub(/\.md$/, "", b)
		hit = (b == ref) || (ref ~ /^[0-9]+$/ && numof(b) == ref + 0)
		if (hit) { n++; out = out (n > 1 ? "\n" : "") f }
	}
	END {
		if (n == 0) exit 1
		print out
		if (n > 1) exit 2
	}'
}

# 新しい方に `Replaces: <古い番号>` を確実に持たせる。無ければ末尾に足し、
# あれば古い番号がまだ無いときだけカンマで追記する(2 回目の replace で
# 同じ新しい ADR が複数の古い ADR を差し替えられるように)。冪等。
ensure_replaces() { # ensure_replaces <ファイル> <古い番号>
	f=$1
	old=$2
	tmp=$f.$$
	awk -v old="$old" '
	/^Replaces:[ \t]*/ {
		line = $0
		sub(/^Replaces:[ \t]*/, "", line)
		n = split(line, a, /,/)
		found = 0
		for (i = 1; i <= n; i++) if (a[i] == old) found = 1
		if (!found) line = line "," old
		print "Replaces: " line
		seen = 1
		next
	}
	{ print }
	END { if (!seen) print "\nReplaces: " old }
	' "$f" >"$tmp" || {
		rm -f "$tmp"
		die "$tmp を書けない"
	}
	mv "$tmp" "$f" || {
		rm -f "$tmp"
		die "$f を置き換えられない"
	}
}

cmd_replace() {
	[ $# -eq 2 ] || die 'usage: adr replace <古い ADR> <新しい ADR>   (番号でも slug でもよい)'
	oldref=${1##*/}
	oldref=${oldref%.md}
	newref=${2##*/}
	newref=${newref%.md}

	dir=$(adr_dir)
	rc=$?
	[ "$rc" -eq "$EX_NODIR" ] &&
		die 'ADR ディレクトリが無い(docs/adr などを探した)。差し替えるものが無い'
	[ "$rc" -eq 0 ] || exit "$rc" # die は既にメッセージを出している

	oldf=$(resolve_ref "$dir" "$oldref")
	rc=$?
	[ "$rc" -eq 1 ] && die "古い方 '$oldref' が $dir に無い"
	[ "$rc" -eq 2 ] && die "古い方 '$oldref' が複数に当たる($(printf '%s' "$oldf" | tr '\n' ' '))。slug で指すこと"
	newf=$(resolve_ref "$dir" "$newref")
	rc=$?
	[ "$rc" -eq 1 ] && die "新しい方 '$newref' が $dir に無い。先に adr new で作ること"
	[ "$rc" -eq 2 ] && die "新しい方 '$newref' が複数に当たる($(printf '%s' "$newf" | tr '\n' ' '))。slug で指すこと"
	[ "$oldf" != "$newf" ] || die "同じ ADR を自分自身では差し替えられない($oldf)"

	oldslug=$(slug_of "$oldf")
	newslug=$(slug_of "$newf")
	name_is_bad "$oldslug" && die "$oldf のファイル名が NNNN-<slug>.md でない。書式どおりでないので触らない"
	name_is_bad "$newslug" && die "$newf のファイル名が NNNN-<slug>.md でない。指す先にできない"
	oldnum=$(num_of "$oldslug")

	# 新しい方が本当に ADR か(題があるか)を見てから、古い方を消す。
	set_fields "$newf"
	[ -n "$title" ] || die "$newf に題(1 行目の '# ...')が無い。指す先にできない"

	ensure_replaces "$newf" "$oldnum"
	# 書いた行を読み返す(書き手と読み手をずらさない)。カンマ区切りの一覧の
	# どこかに古い番号があればよい。
	replaces_line=$(awk '/^Replaces:[ \t]*/{ sub(/^Replaces:[ \t]*/, ""); print; exit }' "$newf")
	case ",$replaces_line," in
	*",$oldnum,"*) ;;
	*) die "書いた 'Replaces: $oldnum' を読み返せない($newf を確認すること)" ;;
	esac

	# 古い方を消す。git 管理下(コミット済み)なら git rm、それ以外は rm ——
	# 消しても記録は git の履歴に残る(README・skill に書いてある前提)。
	if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
		git -C "$dir" ls-files --error-unmatch "$(basename "$oldf")" >/dev/null 2>&1; then
		git -C "$dir" rm -q -- "$(basename "$oldf")" || die "$oldf を git rm できない"
	else
		rm -f "$oldf" || die "$oldf を消せない"
	fi
	printf '%s\n' "$newf"
}

# ---------------------------------------------------------------------------
[ $# -ge 1 ] || {
	usage >&2
	exit 2
}
cmd=$1
shift
case $cmd in
ls | list) cmd_ls "$@" ;;
check) cmd_check "$@" ;;
new) cmd_new "$@" ;;
replace | supersede) cmd_replace "$@" ;; # supersede は旧名。安く保てるので alias で残す
help | -h | --help) usage ;;
*)
	printf '%s: 知らないコマンド: %s\n' "$PROG" "$cmd" >&2
	usage >&2
	exit 2
	;;
esac
