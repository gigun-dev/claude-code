#!/bin/sh
# =============================================================================
# todo — todo.txt 形式のタスクを CLI で操作する
# =============================================================================
# 形式の正は https://github.com/todotxt/todo.txt の README。語彙は todo.txt-cli
# (todo.sh) から借りている。このスクリプトが足しているのは仕様の `key:value`
# 拡張 2 つだけ:
#
#   id:NNNN … `add` が採番する連番(4 桁ゼロ詰め。adr プラグインの NNNN-slug.md と
#            桁を揃えた)。行番号は編集とマージでずれるので、エージェントが
#            タスクを指す手段が仕様の範囲内では他に無い。採番は todo.txt と
#            **done.txt の両方**の max+1 —— done を数えないと、完了済みの id を
#            再利用してしまい、後続の dep: が別のタスクを指すようになる。
#   dep:N  … 依存。カンマ区切りで複数(値に空白・コロンを含まないので仕様内)。
#            ゼロ詰めの有無は問わず、数値として突き合わせる。
#            `ready` はこれを解決して「いま着手できる行」だけを出す。
#
# POSIX sh + awk のみ。bash 固有機能・python・jq に依存しない —— このスクリプトは
# Nix shell の外や Codex の sandbox でも走る必要があり、todo.txt-cli 自身が
# 単一の shell script であるのと同じ判断。
# =============================================================================

set -u

PROG=todo
TODO_DIR=${TODO_DIR:-.}
TODO_FILE="$TODO_DIR/todo.txt"
DONE_FILE="$TODO_DIR/done.txt"
# TODO_TODAY はテスト用の注入点。日付を跨いだ実行で結果が変わるテストを書けない。
TODAY=${TODO_TODAY:-$(date +%Y-%m-%d)}

NL='
'

# 終了コードは --help が正。ここを増やすなら --help も直すこと。
EX_USAGE=1  # 引数・状態の誤り
EX_FORMAT=2 # 形式違反を見つけた / 書けば増やすので書かなかった
EX_NOID=3   # ID が見つからない

# 診断は必ず stderr。データ(行)だけが stdout に出る。
die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit "${2:-$EX_USAGE}"
}

usage() {
	cat <<'EOF'
usage: todo <command> [args]      — リポジトリのタスクを todo.txt 形式で操作する

  add "TEXT"           作成日と id: を付けて todo.txt へ追記し、その行を出す
  ready [TERM...]      dep: がすべて done の open 行 = いま着手できるもの
  ls [TERM...]         open を優先度順に。TERM は AND、先頭 - で除外、大小無視
  listproj [TERM...]   +project の一覧
  listcon [TERM...]    @context の一覧
  show ID...           1 行を出す(done.txt も見る)
  start ID...          @wip を付ける(着手した)。既に付いていれば何もしない
  stop ID...           @wip を外す(未完のまま置いた)。無ければ何もしない
  do ID...             @wip を外して done.txt へ移す。既に done なら何もしない
  pri ID PRIORITY      優先度 (A-Z) を付ける/差し替える
  depri ID...          優先度を外す
  replace ID "TEXT"    本文を置き換える(id:・作成日・優先度は保持)
  append ID "TEXT"     行末に足す
  prepend ID "TEXT"    本文の先頭に足す(優先度と作成日の後ろ)
  check                形式検査。違反があれば stdout に出して 2 で終わる
  id                   id: の無い open 行すべてに id: を配る(冪等)

行の形 (https://github.com/todotxt/todo.txt):

  (A) 2026-09-10 本文 +project @context dep:0001 see:docs/x.md id:0002
  x 2026-09-10 2026-09-08 完了した本文 id:0001              ← done.txt

  (A)..(Z)   任意・先頭のみ。重要度(進行中を表さない —— それは @wip)
  2026-09-10 作成日。任意(add は必ず付ける)。優先度があればその後ろ
  +project   束ね。行にはその次の一手だけを書く
  @context   要る状況(@device @user)。@wip は進行中の印
  id:NNNN    add が採番する連番(4 桁ゼロ詰め)。タスクを指す唯一の手段
  dep:N,M    依存。指す先が done.txt に入るまで ready に出ない
  key:value  自由。key も value も空白とコロンを含めない(URL は書けない)

ID は id: の値。ゼロ詰めは付けても付けなくてよい (todo do 12 = todo do 0012)。
数値としての完全一致のみ —— 3 は 30 に当たらない。
対象は $TODO_DIR/todo.txt と $TODO_DIR/done.txt (既定の TODO_DIR は ".")。
対話しない。データは stdout、診断は stderr。

終了コード:
  0  成功
  1  引数・状態の誤り(usage)
  2  形式違反を見つけた(check)、または書けば増やすので書かなかった
  3  ID が見つからない

テスト用の注入点: TODO_TODAY(日付を固定)
EOF
}

# ---------------------------------------------------------------------------
# awk 共通関数。各コマンドの awk の先頭に差し込む。
# ---------------------------------------------------------------------------
AWKLIB='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
# 行から id:N の N を返す(無ければ "")。複数あれば最後のものを返す —— check が
# 別途「id が複数」を見るので、ここでは黙って 1 つに決める。
function lineid(s,   n, a, i, r) {
	n = split(s, a, /[ \t]+/); r = ""
	for (i = 1; i <= n; i++) if (a[i] ~ /^id:[0-9A-Za-z]+$/) r = substr(a[i], 4)
	return r
}
function idcount(s,   n, a, i, c) {
	n = split(s, a, /[ \t]+/); c = 0
	for (i = 1; i <= n; i++) if (a[i] ~ /^id:/) c++
	return c
}
function pri(s) { if (s ~ /^\([A-Z]\) /) return substr(s, 2, 1); return "" }
function stripri(s) { if (s ~ /^\([A-Z]\) /) return substr(s, 5); return s }
function isdate(s) { return s ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ }
# 優先度を除いた先頭が作成日ならそれを返す。
function created(s,   t) {
	t = stripri(s)
	if (isdate(substr(t, 1, 10)) && (length(t) == 10 || substr(t, 11, 1) == " ")) return substr(t, 1, 10)
	return ""
}
# 優先度と作成日を除いた本文。
function body(s,   t, c) {
	t = stripri(s); c = created(s)
	if (c != "") t = trim(substr(t, 11))
	return t
}
# dep: の値をカンマ区切りで連結して返す。
function depstr(s,   n, a, i, r) {
	n = split(s, a, /[ \t]+/); r = ""
	for (i = 1; i <= n; i++) if (a[i] ~ /^dep:/) r = (r == "" ? substr(a[i], 5) : r "," substr(a[i], 5))
	return r
}
# ソートキー: 優先度(無しは "~" = Z より後ろ)+ 出現順。
# 第2キーを id ではなく出現順にしているのは、行を手で並べ替えたときにその順が
# 保たれるようにするため —— id 順に固定すると、ファイルを読みやすく並べ直す
# 編集が一覧に反映されない。
function sortkey(s, ord,   p) {
	p = pri(s); if (p == "") p = "~"
	return sprintf("%s%09d", p, ord)
}
# 進行中の印は @wip という context ひとつ。優先度は重要度のままにしておく。
# 誰がやっているかは普通の context (@claude / @codex) を自分で足せばよく、
# CLI の機能にはしない。
function stripwip(s,   n, a, i, r) {
	n = split(s, a, /[ \t]+/); r = ""
	for (i = 1; i <= n; i++) {
		if (a[i] == "@wip") continue
		r = (r == "" ? a[i] : r " " a[i])
	}
	return r
}
function hastag(s, tag) { return index(" " s " ", " " tag " ") > 0 }
# id の比較キー。**数字なら数値として**比較する —— 保存形は 4 桁ゼロ詰め
# (id:0012)だが、手で書いた id:12 は同じタスクを指しているつもりのはず。
# 文字列で比べると別物になり、dep:12 が id:0012 に届かず永久に ready へ出ない。
# 数字でないもの(手書きの英字 id)は文字列のまま。接頭辞で名前空間を分けるのは、
# "#12" と "$12" のような衝突を避けるため。
function idkey(v) { return (v ~ /^[0-9]+$/) ? "#" (v + 0) : "$" v }
'

# 空行を落として open 行を出す。ファイルが無ければ何も出さない。
open_lines() {
	[ -f "$TODO_FILE" ] || return 0
	awk 'NF { print }' "$TODO_FILE"
}

done_lines() {
	[ -f "$DONE_FILE" ] || return 0
	awk 'NF { print }' "$DONE_FILE"
}

# 引数の TEXT を検証する。id: の混入を拒むのは、採番の一意性を CLI 側でしか
# 守れないため(人が書いた id: を受け入れると重複が静かに入る)。
check_text() {
	case $1 in
	*"$NL"*) die "TEXT に改行がある。1 行 = 1 タスクなので改行は置けない。分けて 2 回呼ぶこと" ;;
	esac
	[ -n "$(printf '%s' "$1" | tr -d ' \t')" ] || die "TEXT が空。例: todo add \"送信バッファを A/B する +upload @device\""
	case $1 in
	*"id:"*) die "TEXT に id: がある。id は add が採番するので書かない。例: todo add \"次の一手 +upload dep:0003\"" ;;
	esac
}

# 与えられた ID を、ファイルに保存されている形へ解決する。
# **数値としての完全一致のみ**(前方一致は認めない。連番では `3` が 3 にも 30 にも
# 300 にも当たり、どれを指したのか決まらない)。ゼロ詰めの有無は問わないので
# `todo do 12` は id:0012 に当たる。
#
# 同じ番号が違う書き方(id:0012 と id:12)で 2 行にある場合は、どちらを指すか
# 決めずに落とす —— check がその 2 行を重複として名指しするので、直してから来る。
resolve_id() {
	case $1 in
	'' | *[!0-9A-Za-z]*) die "ID '$1' に英数字以外がある。ID は id: の値。例: todo show 3" "$EX_NOID" ;;
	esac
	got=$( (open_lines; done_lines) | awk -v want="$1" "$AWKLIB"'
		{
			id = lineid($0)
			if (id != "" && idkey(id) == idkey(want) && !(id in seen)) { seen[id] = 1; hit[++n] = id }
		}
		END {
			if (n == 1) { print hit[1]; exit 0 }
			if (n > 1) { printf "id:%s と id:%s", hit[1], hit[2]; exit 2 }
			exit 1
		}')
	rc=$?
	[ "$rc" -eq 0 ] || {
		[ "$rc" -eq 2 ] && die "$got が同じ番号を別の書き方で指している。todo check の指摘に従って片方を直すこと" "$EX_NOID"
		die "ID '$1' が todo.txt にも done.txt にも無い。todo ls で id を確かめること" "$EX_NOID"
	}
	printf '%s' "$got"
}

# 保存形は 4 桁ゼロ詰め(id:0001)。adr プラグインの NNNN-slug.md と桁を揃えてある
# —— 同じリポジトリで 2 種類の採番が並ぶので、見た目が同じ方が読み違えない。
# 9999 を超えたら 5 桁になるだけで、特別扱いはしない。
fmt_id() { printf '%04d' "$1"; }

# 次の連番を返す(ゼロ詰めしない生の数)。max は todo.txt と done.txt の**両方**から
# 取る —— done を数えないと、完了済みの id を再利用してしまい、後続の dep: が
# 別のタスクを指すようになる。逆に言えば、done.txt からその行を消すまで id は
# 解放されない。ゼロ詰めの有無に関わらず数値として比べる。
#
# 複数配るとき(`id`)は、この値を起点に +1 していけばよい。状態は持たない。
next_id() {
	(open_lines; done_lines) | awk "$AWKLIB"'
		{ id = lineid($0); if (id ~ /^[0-9]+$/ && id + 0 > max) max = id + 0 }
		END { print max + 1 }'
}

# 指定 ID の open 行を出す。無ければ非ゼロ。
find_open() {
	out=$(open_lines | awk -v want="$1" "$AWKLIB"' $0 != "" && lineid($0) == want { print; found++ } END { exit(found ? 0 : 1) }') || return 1
	printf '%s\n' "$out"
}

# todo.txt を書き換える。awk に元の行を流し、出力で丸ごと置き換える。
# 一時ファイル経由なのは、途中で失敗したときに元ファイルを壊さないためと、
# 書き込む前に gate_write で検査できるようにするため。
rewrite_todo() {
	tmp="$TODO_FILE.$$"
	if open_lines | "$@" >"$tmp"; then
		gate_write "$tmp" "$DONE_FILE" "$OPNAME" || {
			rm -f "$tmp"
			return "$EX_FORMAT"
		}
		mv "$tmp" "$TODO_FILE"
	else
		rm -f "$tmp"
		die "$OPNAME: 行の書き換え(awk)に失敗した"
	fi
}

# ---------------------------------------------------------------------------
cmd_add() {
	[ $# -eq 1 ] || die "usage: todo add \"TEXT\"   (例: todo add \"送信バッファを A/B する +upload @device\")"
	check_text "$1"
	text=$(printf '%s' "$1" | awk "$AWKLIB"'{ print trim($0) }')

	next=$(fmt_id "$(next_id)") || exit 1

	# 優先度は仕様上「必ず先頭」。テキストが (A) で始まっていたら作成日はその後ろ。
	prefix=''
	case $text in
	'('[A-Z]') '*)
		prefix=$(printf '%s' "$text" | cut -c1-4)
		text=$(printf '%s' "$text" | cut -c5-)
		;;
	esac

	[ -f "$TODO_FILE" ] || : >"$TODO_FILE" || die "$TODO_FILE を作れない"
	line="$prefix$TODAY $text id:$next"

	# 追記も一旦候補ファイルを作って関門を通す。dep: のタイポ(宙吊り)や
	# key:value の形式違反は、書いてしまってからでは静かに残る。
	tmp="$TODO_FILE.$$"
	{ cat "$TODO_FILE" && printf '%s\n' "$line"; } >"$tmp" || {
		rm -f "$tmp"
		die "$TODO_FILE へ書けない"
	}
	gate_write "$tmp" "$DONE_FILE" add || {
		rm -f "$tmp"
		exit "$EX_FORMAT"
	}
	mv "$tmp" "$TODO_FILE" || die "$TODO_FILE を置き換えられない"
	printf '%s\n' "$line"
}

# id: の無い open 行に id: を配る。手で足した行を CLI の操作対象に引き上げる唯一の
# 手段 —— これが無いと「id が無い」という check の指摘に対して、利用者が次の番号を
# 自分で数えて書くしかない。冪等(id を持つ行には触らない)。
cmd_id() {
	[ $# -eq 0 ] || die "usage: todo id   (引数は取らない。id: の無い open 行すべてに配る)"
	n=$(open_lines | awk "$AWKLIB"'lineid($0) == "" { c++ } END { print c + 0 }')
	if [ "$n" -eq 0 ]; then
		printf '%s: id: の無い open 行は無い。何もしない\n' "$PROG" >&2
		return 0
	fi
	base=$(next_id) || exit 1
	rewrite_todo awk -v base="$base" "$AWKLIB"'
		{ if (lineid($0) == "") { printf "%s id:%04d\n", $0, base + k; k++ } else print }
	' || exit $?
	i=0
	while [ "$i" -lt "$n" ]; do
		find_open "$(fmt_id $((base + i)))"
		i=$((i + 1))
	done
}

cmd_prepend() {
	[ $# -eq 2 ] || die "usage: todo prepend ID \"TEXT\"   (例: todo prepend 3 \"先に\")"
	check_text "$2"
	resolve_open_set 1 "$1" || exit $?
	text=$(printf '%s' "$2" | awk "$AWKLIB"'{ print trim($0) }')
	# 挿す位置は優先度と作成日の**後ろ**。仕様上この 2 つより前には何も置けない。
	rewrite_todo awk -v want="$resolved" -v text="$text" "$AWKLIB"'
		{
			if (lineid($0) != want) { print; next }
			p = pri($0); c = created($0)
			print (p == "" ? "" : "(" p ") ") (c == "" ? "" : c " ") text " " body($0)
		}
	' || exit $?
	find_open "$resolved"
}

# 引数の ID 群を解決し、open のものを set_out(",a,b," 形式)と resolved
# (空白区切り)に、既に done のものを settled に振り分ける。
# 解決できない ID があれば何も書き換えずに落ちる —— 途中まで適用された状態を作らない。
#
# strict=1 なら「done にある」も誤りとして落とす(start/stop/pri など、完了済みの
# 行に対して意味を持たない操作)。do だけは strict=0 —— 二度目の `do` はエラーでは
# なく何もしないのが正しい(結果は同じ「done である」なので、冪等)。
resolve_open_set() {
	strict=$1
	shift
	set_out=','
	resolved=''
	settled=''
	for a in "$@"; do
		rid=$(resolve_id "$a") || return "$EX_NOID"
		if find_open "$rid" >/dev/null; then
			set_out="$set_out$rid,"
			resolved="${resolved:+$resolved }$rid"
		elif [ "$strict" -eq 1 ]; then
			printf '%s: id:%s は done.txt にある。完了済みの行にこの操作はできない\n' "$PROG" "$rid" >&2
			return "$EX_USAGE"
		else
			settled="${settled:+$settled }$rid"
		fi
	done
}

show_ids() {
	for id in $1; do
		(open_lines; done_lines) | awk -v want="$id" "$AWKLIB"'lineid($0) == want { print }'
	done
}

cmd_do() {
	[ $# -ge 1 ] || die "usage: todo do ID...   (例: todo do 3)"
	resolve_open_set 0 "$@" || exit $?
	ids=$set_out

	# 既に done の ID しか無いなら、何も書かずに成功で返す(冪等)。
	if [ -z "$resolved" ]; then
		printf '%s: 指定された ID はすべて既に done.txt にある。何もしない\n' "$PROG" >&2
		show_ids "$settled"
		return 0
	fi
	[ -z "$settled" ] || printf '%s: id:%s は既に done.txt にある。飛ばす\n' "$PROG" "$settled" >&2

	tmp_todo="$TODO_FILE.$$"
	tmp_done="$DONE_FILE.$$"
	: >"$tmp_todo" || die "$TODO_FILE を書き換えられない"
	: >"$tmp_done" || { rm -f "$tmp_todo"; die "$DONE_FILE を書き換えられない"; }

	# 完了行は仕様どおり `x <完了日> <作成日> <本文>`。優先度は多くのクライアントと
	# 同じく落とす(残したければ pri:A を自分で書く)。id: は残す —— 後続の dep: が
	# 「その id は done にあるか」で解決するので、消すと ready が壊れる。
	# @wip は進行中の印なので、完了と同時に落とす。
	open_lines | awk -v ids="$ids" -v today="$TODAY" -v dfile="$tmp_done" "$AWKLIB"'
		{
			id = lineid($0)
			if (id != "" && index(ids, "," id ",") > 0) print "x " today " " stripwip(stripri($0)) >> dfile
			else print
		}' >"$tmp_todo" || {
		rm -f "$tmp_todo" "$tmp_done"
		die "書き換えに失敗した"
	}

	[ -f "$DONE_FILE" ] || : >"$DONE_FILE" || die "$DONE_FILE を作れない"

	# 2 ファイルを同時に変えるので、関門にも 2 ファイルの候補を渡す。
	tmp_full="$DONE_FILE.full.$$"
	cat "$DONE_FILE" "$tmp_done" >"$tmp_full" || die "$DONE_FILE を組み立てられない"
	gate_write "$tmp_todo" "$tmp_full" do || {
		rm -f "$tmp_todo" "$tmp_done" "$tmp_full"
		exit "$EX_FORMAT"
	}
	mv "$tmp_full" "$DONE_FILE" || die "$DONE_FILE を置き換えられない"
	mv "$tmp_todo" "$TODO_FILE" || die "$TODO_FILE を置き換えられない"
	cat "$tmp_done"
	rm -f "$tmp_done"
}

cmd_pri() {
	[ $# -eq 2 ] || die "usage: todo pri ID PRIORITY   (例: todo pri 3 A)"
	case $2 in
	[A-Z]) ;;
	*) die "優先度は A-Z の 1 文字: $2" ;;
	esac
	resolve_open_set 1 "$1" || exit $?
	rewrite_todo awk -v want="$resolved" -v p="$2" "$AWKLIB"'
		{ if (lineid($0) == want) print "(" p ") " stripri($0); else print }
	' || exit $?
	find_open "$resolved"
}

cmd_depri() {
	[ $# -ge 1 ] || die "usage: todo depri ID...   (例: todo depri 3)"
	resolve_open_set 1 "$@" || exit $?
	rewrite_todo awk -v ids="$set_out" "$AWKLIB"'
		{ id = lineid($0); if (id != "" && index(ids, "," id ",") > 0) print stripri($0); else print }
	' || exit $?
	for id in $resolved; do find_open "$id"; done
}

# start / stop —— 「進行中」は優先度ではなく @wip という context ひとつで表す。
# 優先度 (A)..(Z) は重要度・順序の意味のまま残す(混ぜると、着手した瞬間に
# 重要度の情報が消える)。見るのは `todo ls @wip`。
cmd_start() {
	[ $# -ge 1 ] || die "usage: todo start ID...   (例: todo start 3)"
	resolve_open_set 1 "$@" || exit $?
	rewrite_todo awk -v ids="$set_out" "$AWKLIB"'
		{
			id = lineid($0)
			if (id == "" || index(ids, "," id ",") == 0) { print; next }
			print hastag($0, "@wip") ? $0 : $0 " @wip"
		}
	' || exit $?
	for id in $resolved; do find_open "$id"; done
}

cmd_stop() {
	[ $# -ge 1 ] || die "usage: todo stop ID...   (例: todo stop 3)"
	resolve_open_set 1 "$@" || exit $?
	rewrite_todo awk -v ids="$set_out" "$AWKLIB"'
		{
			id = lineid($0)
			if (id != "" && index(ids, "," id ",") > 0) print stripwip($0)
			else print
		}
	' || exit $?
	for id in $resolved; do find_open "$id"; done
}

cmd_replace() {
	[ $# -eq 2 ] || die "usage: todo replace ID \"TEXT\"   (例: todo replace 3 \"新しい本文 +upload\")"
	check_text "$2"
	resolve_open_set 1 "$1" || exit $?
	text=$(printf '%s' "$2" | awk "$AWKLIB"'{ print trim($0) }')
	# 新しい本文が (A) で始まっていたらそれを優先度として採る。無ければ元の優先度を
	# 保つ —— replace は「本文の置き換え」であって、優先度と作成日と id は本文ではない。
	rewrite_todo awk -v want="$resolved" -v text="$text" "$AWKLIB"'
		{
			if (lineid($0) != want) { print; next }
			p = pri($0); c = created($0); t = text
			if (t ~ /^\([A-Z]\) /) { p = substr(t, 2, 1); t = substr(t, 5) }
			out = (p == "" ? "" : "(" p ") ") (c == "" ? "" : c " ") t " id:" want
			print out
		}
	' || exit $?
	find_open "$resolved"
}

cmd_append() {
	[ $# -eq 2 ] || die "usage: todo append ID \"TEXT\"   (例: todo append 3 \"dep:0001\")"
	check_text "$2"
	resolve_open_set 1 "$1" || exit $?
	text=$(printf '%s' "$2" | awk "$AWKLIB"'{ print trim($0) }')
	rewrite_todo awk -v want="$resolved" -v text="$text" "$AWKLIB"'
		{ if (lineid($0) == want) print $0 " " text; else print }
	' || exit $?
	find_open "$resolved"
}

# TERM を 1 変数にまとめて awk へ渡す。todo.sh と同じく AND、先頭 "-" で除外、
# 大文字小文字は区別しない。
#
# 区切りが改行ではなく US (0x1f) なのは、awk のコマンドライン変数に生の改行を
# 渡せない実装がある(macOS の awk は "newline in string" で落ちる)ため。
# 渡し方も `var=value` オペランドではなく `-v` —— オペランドの代入は BEGIN の
# **後**に処理されるので、BEGIN で terms を分解するこの実装では空に見える
# (2026-09-09 実際にフィルタが素通りした)。
US=$(printf '\037')
terms_of() {
	out=''
	for t in "$@"; do
		if [ -z "$out" ]; then out=$t; else out="$out$US$t"; fi
	done
	printf '%s' "$out"
}

FILTER='
	BEGIN {
		nt = split(terms, tt, sep)
		for (i = 1; i <= nt; i++) if (tt[i] == "") tt[i] = "\001"  # 空要素は必ずマッチしない値へ
	}
	function matches(s,   i, t, neg, lo) {
		lo = tolower(s)
		for (i = 1; i <= nt; i++) {
			t = tt[i]
			if (t == "\001") continue
			neg = 0
			if (substr(t, 1, 1) == "-") { neg = 1; t = substr(t, 2) }
			if (t == "") continue
			if (neg == (index(lo, tolower(t)) > 0)) return 0
		}
		return 1
	}
'

# 一覧の前に検査結果を出す。手で編集したファイルの壊れは、次に一覧を見た
# ときに気づけないと直らない —— フックを置かない代わりに、必ず通る経路へ置く。
# 一覧そのものは成功なので終了コードは 0 のまま(壊れを理由に一覧を隠さない)。
show_findings() {
	run_check "$TODO_FILE" "$DONE_FILE" | grep -v '^check: ' || true
}

cmd_ls() {
	show_findings
	terms=$(terms_of "$@")
	open_lines | awk -v terms="$terms" -v sep="$US" "$AWKLIB$FILTER"'
		matches($0) { printf "%s\t%s\n", sortkey($0, NR), $0 }
	' | LC_ALL=C sort | cut -f2-
}

cmd_ready() {
	show_findings
	terms=$(terms_of "$@")
	# dep: の解決は「その id が done.txt にあるか」だけで決める。
	# done に無い id(= open のまま / そもそも存在しない)は解決しない = ready ではない。
	# 宙吊り(どちらにも無い)は check が別途エラーとして名指しする —— ここで
	# 「知らない id は無視して ready 扱い」にすると、タイポが黙って着手可能に化ける。
	{
		done_lines | sed 's/^/D /'
		open_lines | sed 's/^/O /'
	} | awk -v terms="$terms" -v sep="$US" "$AWKLIB$FILTER"'
		{ tag = substr($0, 1, 1); line = substr($0, 3) }
		tag == "D" { id = lineid(line); if (id != "") isdone[idkey(id)] = 1; next }
		{
			if (!matches(line)) next
			d = depstr(line)
			if (d != "") {
				n = split(d, a, ",")
				for (i = 1; i <= n; i++) if (a[i] != "" && !(idkey(a[i]) in isdone)) next
			}
			printf "%s\t%s\n", sortkey(line, NR), line
		}
	' | LC_ALL=C sort | cut -f2-
}

list_tokens() {
	sigil=$1
	shift
	terms=$(terms_of "$@")
	open_lines | awk -v terms="$terms" -v sep="$US" -v sig="$sigil" "$AWKLIB$FILTER"'
		matches($0) {
			n = split(body($0), a, /[ \t]+/)
			for (i = 1; i <= n; i++) if (substr(a[i], 1, 1) == sig && length(a[i]) > 1) print a[i]
		}
	' | LC_ALL=C sort -u
}

cmd_show() {
	[ $# -ge 1 ] || die "usage: todo show ID...   (例: todo show 3)"
	missing=0
	for a in "$@"; do
		rid=$(resolve_id "$a") || {
			missing=1
			continue
		}
		(open_lines; done_lines) | awk -v want="$rid" "$AWKLIB"'lineid($0) == want { print }'
	done
	[ "$missing" -eq 0 ] || return "$EX_NOID"
}

# run_check <todo ファイル> <done ファイル>
# ファイルを引数に取るのは、書き込み前の候補(一時ファイル)を同じ検査に
# かけるため —— 検査の実装をコマンドごとに二重化しない。
run_check() {
	{
		[ -f "$1" ] && awk 'NF { print "O " $0 }' "$1"
		[ -f "$2" ] && awk 'NF { print "D " $0 }' "$2"
	} | awk "$AWKLIB"'
		{
			tag = substr($0, 1, 1); line = substr($0, 3)
			n++
			where = (tag == "O" ? "todo.txt" : "done.txt")

			# --- 形式 -----------------------------------------------------
			if (tag == "O" && line ~ /^x /) {
				err("todo.txt に完了行がある(done.txt へ移すこと)", line); next
			}
			if (tag == "D" && line !~ /^x /) {
				err("done.txt に \"x \" で始まらない行がある", line); next
			}
			# 完了日は仕様上「必須」。作成日は「任意」なので、無くても違反にしない
			# —— `add` は必ず付けるが、手で書いた行を追い返す理由が仕様に無い。
			if (tag == "D") {
				# x <完了日> [<作成日> ]<本文>
				if (!isdate(substr(line, 3, 10))) { err("完了日が YYYY-MM-DD でない (x の直後に必要)", line); next }
			}

			# --- key:value ------------------------------------------------
			# 仕様: key も value も空白とコロンを含まない。空白はトークン分割で
			# 構造上入りようがないので、実質「1 トークンにコロンは 1 つまで」。
			# これに引っかかる代表例が see:https://... —— URL は書けない。
			nk = split(line, kv, /[ \t]+/)
			for (ki = 1; ki <= nk; ki++) {
				if (index(kv[ki], ":") == 0) continue
				if (kv[ki] !~ /^[^: \t]+:[^: \t]+$/)
					err("key:value の形式違反 (" kv[ki] ") —— key も value もコロンを含めない", line)
			}

			# --- id -------------------------------------------------------
			c = idcount(line)
			if (c == 0) { err("id: が無い —— `todo id` で付ける(無いと add 以外のコマンドがこの行を触れない)", line); next }
			if (c > 1) { err("id: が 2 つ以上ある", line); next }
			id = lineid(line)
			if (id == "") { err("id: の値が英数字でない", line); next }
			# 突き合わせは idkey(数字なら数値)。id:0012 と id:12 は同じ番号を
			# 指しているので、書き方が違っても重複として拾う。
			k = idkey(id)
			if (k in seen) err("id:" id " は id:" disp[k] " (" seen[k] ") と同じ番号を指している", line)
			else { seen[k] = where; disp[k] = id }
			deps[k] = depstr(line)
			owner[k] = where
			if (!(k in disp)) disp[k] = id

			# --- dep ------------------------------------------------------
			if (deps[k] != "") {
				m = split(deps[k], a, ",")
				for (i = 1; i <= m; i++) {
					if (a[i] !~ /^[0-9A-Za-z]+$/) { err("dep: の値が id の形をしていない (" a[i] ")", line); deps[k] = "" }
					else if (idkey(a[i]) == k) err("自分自身に dep している", line)
				}
			}
		}
		END {
			# --- 宙吊り dep ------------------------------------------------
			for (k in deps) {
				if (deps[k] == "") continue
				m = split(deps[k], a, ",")
				for (i = 1; i <= m; i++) if (!(idkey(a[i]) in owner)) {
					err("dep:" a[i] " が todo.txt にも done.txt にも無い", "id:" disp[k])
					gsub("(^|,)" a[i] "(,|$)", ",", deps[k])  # 循環判定からは外す
				}
			}
			# --- 循環 dep --------------------------------------------------
			# Kahn 法: 依存がすべて解決した節点を落とし続け、落ちなかった節点が
			# 循環(または循環に依存するもの)。宙吊りは上で外してあるので、ここに
			# 残るのは本物の循環だけ。
			for (k in owner) live[k] = 1
			changed = 1
			while (changed) {
				changed = 0
				# 走査は owner。live を回しながら live から delete するのは
				# awk では未定義動作なので、別の配列を回す。
				for (k in owner) {
					if (!(k in live)) continue
					ok = 1
					if (deps[k] != "") {
						m = split(deps[k], a, ",")
						for (i = 1; i <= m; i++) if (a[i] != "" && (idkey(a[i]) in live)) ok = 0
					}
					if (ok) { delete live[k]; changed = 1 }
				}
			}
			for (k in live) { stuck = stuck (stuck == "" ? "" : ",") disp[k] }
			if (stuck != "") {
				m = split(stuck, a, ",")
				# 出力順を安定させる(awk の for-in は順不同)。
				for (i = 1; i <= m; i++) for (j = i + 1; j <= m; j++)
					if (a[j] + 0 < a[i] + 0) { s = a[i]; a[i] = a[j]; a[j] = s }
				for (i = 1; i <= m; i++) err("dep が循環している", "id:" a[i])
			}
			if (nerr == 0) print "check: 問題なし (" n + 0 " 行)"
			exit(nerr ? 2 : 0)
		}
		function err(msg, ctx) { nerr++; printf "✗ %s\n    %s\n", msg, ctx }
	'
}

cmd_check() { run_check "$TODO_FILE" "$DONE_FILE"; }

# 違反の件数だけ数える。「増えたか」で判定するので、絶対数は要らない。
count_errs() { run_check "$1" "$2" | grep -c '^✗' || true; }

# 書き込みの関門。候補ファイルの違反件数が現状より増えるなら書かない。
#
# 「0 件でなければ拒む」ではなく「増えるなら拒む」なのは、手で編集した結果
# 既に違反がある状態から CLI で直せなくなるのを避けるため —— 仕様の第一目標は
# 「テキストエディタで編集できること」なので、CLI が人の手を締め出してはいけない。
#
# フックは使わない。呼ばれる保証が無い場所へ検査を置くと、検査が黙って死ぬ。
gate_write() { # gate_write <候補 todo> <候補 done> <操作名>
	base=$(count_errs "$TODO_FILE" "$DONE_FILE")
	after=$(count_errs "$1" "$2")
	[ "$after" -le "$base" ] && return 0
	printf '%s: %s は形式違反を %d → %d 件へ増やす。書き込まなかった。\n' \
		"$PROG" "$3" "$base" "$after" >&2
	run_check "$1" "$2" | grep -v '^check: ' >&2
	return 1
}

# ---------------------------------------------------------------------------
[ $# -ge 1 ] || {
	usage >&2
	exit 2
}
cmd=$1
OPNAME=$cmd
shift
case $cmd in
add | a) cmd_add "$@" ;;
do) cmd_do "$@" ;;
start) cmd_start "$@" ;;
stop) cmd_stop "$@" ;;
pri | p) cmd_pri "$@" ;;
depri | dp) cmd_depri "$@" ;;
replace) cmd_replace "$@" ;;
append | app) cmd_append "$@" ;;
prepend | prep) cmd_prepend "$@" ;;
ls | list) cmd_ls "$@" ;;
listproj | lsprj) list_tokens '+' "$@" ;;
listcon | lsc) list_tokens '@' "$@" ;;
ready) cmd_ready "$@" ;;
show) cmd_show "$@" ;;
check) cmd_check "$@" ;;
id) cmd_id "$@" ;;
help | -h | --help) usage ;;
*)
	printf '%s: 知らないコマンド: %s\n' "$PROG" "$cmd" >&2
	usage >&2
	exit 2
	;;
esac
